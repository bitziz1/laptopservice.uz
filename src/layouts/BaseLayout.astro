---
import { siteConfig } from "@/data/siteConfig";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import SchemaOrg from "@/components/SchemaOrg.astro";
import "@/styles/global.css";

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalUrl?: string;
  type?: "LocalBusiness" | "Service" | "Article" | "HowTo" | "FAQPage" | "General";
  serviceData?: {
    name: string;
    description: string;
    price?: string;
  };
  howToSteps?: {
    name: string;
    text: string;
  }[];
  faqList?: {
    question: string;
    answer: string;
  }[];
  breadcrumbs?: {
    name: string;
    url: string;
  }[];
}

const currentPath = Astro.url.pathname;
const ogSlug = currentPath === '/' ? 'index' : currentPath.replace(/^\/|\/$/g, '');
const defaultOg = `${siteConfig.url}/og/${ogSlug}.png`;

const {
  title = siteConfig.siteName,
  description = "Ремонт ноутбуков в Ташкенте (ул. Паркент 11). BGA-пайка, чистка от пыли, замена термоинтерфейсов, восстановление после залития. Согласование стоимости до ремонта.",
  image = defaultOg,
  canonicalUrl = Astro.url.href,
  type = "General",
  serviceData,
  howToSteps,
  faqList,
  breadcrumbs,
} = Astro.props;

const fullTitle = title.includes("Laptop Service") ? title : `${title} — Laptop Service`;
---

<!DOCTYPE html>
<html lang="ru" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Performance: preconnect kept but scripts deferred -->
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
    <link rel="dns-prefetch" href="https://mc.yandex.ru" />
    <link rel="dns-prefetch" href="https://mc.yandex.com" />

    <!-- Preload LCP-related critical assets -->
    <link rel="preload" href="/logo.svg" as="image" type="image/svg+xml" fetchpriority="high" />

    <!-- Google Tag Manager + Yandex.Metrika — deferred until idle/interaction to unblock LCP/TBT -->
    <script is:inline>
    (()=>{let g=false,y=false;function loadGTM(){if(g)return;g=true;(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','GTM-MHDMSHWH');}
    function loadYM(){if(y)return;y=true;(function(m,e,t,r,i,k,a){m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};m[i].l=1*new Date();for(var j=0;j<document.scripts.length;j++){if(document.scripts[j].src===r){return;}}k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)})(window,document,'script','https://mc.yandex.ru/metrika/tag.js?id=111901353','ym');ym(111901353,'init',{ssr:true,webvisor:true,clickmap:true,ecommerce:"dataLayer",referrer:document.referrer,url:location.href,accurateTrackBounce:true,trackLinks:true});}
    function loadAll(){loadGTM();loadYM();}
    const idle=window.requestIdleCallback?(cb)=>requestIdleCallback(cb,{timeout:3500}):(cb)=>setTimeout(cb,3500);
    idle(loadAll);
    ['scroll','mousemove','touchstart','click','keydown'].forEach(ev=>window.addEventListener(ev,loadAll,{once:true,passive:true}));
    setTimeout(loadAll,5000);
    })();
    </script>

    <!-- Open Graph / Social -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:site_name" content={siteConfig.brandName} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <!-- Favicon & App Icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="192x192" href="/apple-touch-icon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="apple-touch-icon" sizes="192x192" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#171A20" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Laptop Service" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="application-name" content="Laptop Service" />
    <meta name="msapplication-TileColor" content="#171A20" />
    <meta name="msapplication-TileImage" content="/apple-touch-icon.png" />

    <!-- Hreflang -->
    <link rel="alternate" hreflang="ru" href={canonicalUrl} />
    <link rel="alternate" hreflang="uz" href={canonicalUrl} />
    <link rel="alternate" hreflang="x-default" href={canonicalUrl} />

    <!-- Schema.org Microdata -->
    <SchemaOrg
      type={type}
      title={fullTitle}
      description={description}
      url={canonicalUrl}
      image={image}
      serviceData={serviceData}
      howToSteps={howToSteps}
      faqList={faqList}
      breadcrumbs={breadcrumbs}
    />
  </head>

  <body class="bg-chassis-900 text-chassis-200 min-h-screen flex flex-col selection:bg-chassis-700 selection:text-chassis-100">
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-MHDMSHWH"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->

    <!-- Yandex.Metrika counter (noscript) -->
    <noscript><div><img src="https://mc.yandex.ru/watch/111901353" style="position:absolute; left:-9999px;" alt="" /></div></noscript>
    <!-- /Yandex.Metrika counter -->

    <!-- Top Notification Bar — brand color #00bb9c -->
    <div class="w-full" style="background:#00bb9c">
      <div class="max-w-7xl mx-auto px-4 py-2.5 text-center text-white text-xs sm:text-sm leading-tight">
        <span>⏳ Нужна помощь?</span>
        <a href={siteConfig.telegram.masterUrl} target="_blank" rel="noopener noreferrer" class="underline underline-offset-2 decoration-white/80 hover:decoration-white font-bold hover:opacity-90 transition-opacity">Написать в Telegram</a>
      </div>
    </div>

    <Header currentPath={currentPath} />

    <main id="main-content" class="flex-1">
      <slot />
    </main>

    <Footer />
  </body>
</html>
