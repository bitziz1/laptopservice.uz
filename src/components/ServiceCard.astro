---
import { siteConfig } from "@/data/siteConfig";
import IconLink from "@/components/IconLink.astro";
import ServiceAnimation from "@/components/ServiceAnimation.astro";

interface Props {
  service: any;
  ctaLabel?: string;
}

const { service, ctaLabel = "Узнать стоимость" } = Astro.props;
const data = service.data ?? service;
const rawId: string = service.id ?? data.slug ?? "";
const slug: string = service.slug ?? (rawId.includes("/") ? rawId.split("/").pop()!.replace(/\.md$/, "") : rawId.replace(/\.md$/, "")) ?? "";
const title: string = data.title ?? service.title ?? "";
const shortDescription: string = data.shortDescription ?? service.shortDescription ?? "";
const symptoms: string[] = (data.symptoms as string[]) ?? (service.symptoms as string[]) ?? [];
const telegramHref = `${siteConfig.telegram.masterUrl}${siteConfig.telegram.masterUrl.includes("?") ? "&" : "?"}text=${encodeURIComponent(`Меня интересует ${title}. Модель устройства: `)}`;

// Анимации: только webm (прозрачный фон вырезан) — public/videos/services/<slug>.webm
// Фото: только webp прозрачный — public/images/services/<slug>.webp
import fs from "node:fs";
let anim: { webm: string; poster: string; alt: string } | undefined;
let pubImg: string | undefined;
try {
  const webmPath = `public/videos/services/${slug}.webm`;
  if (fs.existsSync(webmPath)) {
    const poster = fs.existsSync(`public/videos/services/${slug}-poster.webp`) ? `/videos/services/${slug}-poster.webp` : "";
    anim = {
      webm: `/videos/services/${slug}.webm`,
      poster: poster || "",
      alt: `${title} — анимация`,
    };
  }
  if (!anim) {
    const webp = `public/images/services/${slug}.webp`;
    if (fs.existsSync(webp)) pubImg = `/images/services/${slug}.webp`;
  }
} catch {}
---

<div class="rounded-lg bg-chassis-850/50 overflow-hidden flex flex-col justify-between">
  {anim ? (
    <div class="w-full bg-[#171A20]">
      <ServiceAnimation
        webm={anim.webm}
        poster={anim.poster}
        alt={anim.alt}
      />
    </div>
  ) : pubImg ? (
    <div class="w-full bg-[#171A20] flex items-center justify-center p-2">
      <img src={pubImg} alt={title} class="w-full h-auto object-contain max-h-48" loading="lazy" decoding="async" />
    </div>
  ) : null}
  <div class="p-5 sm:p-6 flex flex-col justify-between flex-1 space-y-4">
    <div class="space-y-3">
      <h3 class="text-lg font-extrabold text-chassis-100 leading-tight">
        <a href={`/services/${slug}`} class="hover:underline">
          {title}
        </a>
      </h3>

      <p class="text-xs text-chassis-400 leading-relaxed line-clamp-3">
        {shortDescription}
      </p>

      {symptoms.length > 0 && (
        <div class="space-y-1 pt-1">
          <div class="text-[10px] font-sans uppercase text-chassis-400">Характерные признаки:</div>
          {symptoms.slice(0, 2).map((symptom) => (
            <div class="text-xs text-chassis-300 flex items-start gap-1.5">
              <span class="text-chassis-400 font-sans">-</span>
              <span class="line-clamp-1">{symptom}</span>
            </div>
          ))}
        </div>
      )}
    </div>

    <!-- Bottom Actions -->
    <div class="space-y-2">

      <div class="grid grid-cols-2 gap-2">
      <a
        href={`/services/${slug}`}
        class="py-2 px-3 rounded border border-chassis-800 bg-chassis-900 hover:bg-chassis-800 text-chassis-300 text-center text-xs font-sans transition-colors"
      >
        Подробнее
      </a>
      <IconLink
        type="telegram"
        href={telegramHref}
        label={ctaLabel}
        ariaLabel={ctaLabel}
        variant="button"
        target="_blank"
        class="py-2 px-2 justify-center text-xs font-sans font-bold"
      />
      </div>
    </div>
  </div>
</div>