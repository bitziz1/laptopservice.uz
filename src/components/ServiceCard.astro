---
import type { ServiceItem } from "@/data/services";
import { siteConfig } from "@/data/siteConfig";

interface Props {
  service: ServiceItem;
}

const { service } = Astro.props;
---

<div class="rounded-lg border border-chassis-800 bg-chassis-850 p-5 sm:p-6 flex flex-col justify-between hover:border-chassis-700 transition-colors">
  
  <div class="space-y-3">
    <div class="flex items-center justify-between gap-2 border-b border-chassis-800 pb-3">
      <span class="text-[11px] font-mono text-chassis-400 uppercase tracking-wider">Сервисный центр</span>
      <span class="text-[11px] font-mono text-chassis-300">Сроки: {service.timeRange}</span>
    </div>

    <h3 class="text-base sm:text-lg font-bold text-chassis-100">
      <a href={`/services/${service.slug}`} class="hover:underline">
        {service.title}
      </a>
    </h3>

    <p class="text-xs sm:text-sm text-chassis-400 leading-relaxed">
      {service.shortDescription}
    </p>

    <!-- Typical Symptoms -->
    <div class="space-y-1 pt-1">
      <div class="text-[10px] font-mono uppercase text-chassis-400">Характерные признаки:</div>
      {service.symptoms.slice(0, 2).map((symptom) => (
        <div class="text-xs text-chassis-300 flex items-start gap-1.5">
          <span class="text-chassis-400 font-mono">-</span>
          <span class="line-clamp-1">{symptom}</span>
        </div>
      ))}
    </div>
  </div>

  <!-- Bottom Actions -->
  <div class="pt-4 mt-4 border-t border-chassis-800 space-y-2">
    <div class="text-[11px] font-mono text-chassis-400">
      Оценка стоимости — после осмотра платы.
    </div>

    <div class="grid grid-cols-2 gap-2 pt-1">
      <a
        href={`/services/${service.slug}`}
        class="py-2 px-3 rounded border border-chassis-800 bg-chassis-900 hover:bg-chassis-800 text-chassis-300 text-center text-xs font-mono transition-colors"
      >
        Подробнее
      </a>
      <a
        href={siteConfig.telegram.masterUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="py-2 px-3 rounded border border-chassis-700 bg-chassis-800 hover:bg-chassis-700 text-chassis-100 text-center text-xs font-mono font-medium transition-colors"
      >
        Спросить в TG
      </a>
    </div>
  </div>

</div>