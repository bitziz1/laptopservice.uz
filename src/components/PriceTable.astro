---
import { siteConfig } from "@/data/siteConfig";
import IconLink from "@/components/IconLink.astro";

const workflowSteps = [
  {
    step: "01",
    title: "Доставка или визит в сервисный центр",
    desc: "Привезите ноутбук по адресу ул. Паркент 11 (напротив Паркентского базара) или отправьте курьером через сервис Яндекс Доставка."
  },
  {
    step: "02",
    title: "Аппаратная диагностика платы",
    desc: "Мастер разбирает устройство, производит замеры сопротивлений, проверяет сигналы осциллографом, тепловизором и ЛБП для выявления точной причины неисправности."
  },
  {
    step: "03",
    title: "Согласование стоимости ДО ремонта",
    desc: "Мастер связывается с вами, объясняет причину поломки и озвучивает точную стоимость работы и комплектующих. Без вашего согласия ремонт не начинается."
  },
  {
    step: "04",
    title: "Ремонт и стресс-тестирование",
    desc: "Проведение пайки / замены чипов / чистки с последующей обязательной проверкой под нагрузкой."
  },
  {
    step: "05",
    title: "Выдача устройства и гарантия",
    desc: "Оплата производится по факту выполненных работ. Предоставляется гарантия сервисного центра."
  }
];
---

<div class="space-y-10">
  
  <!-- Diagnostic Principle Alert -->
  <div class="py-2 space-y-3">
    <div class="text-xs font-sans text-chassis-400 uppercase tracking-wider">Главный принцип</div>
    <h3 class="text-lg sm:text-xl font-bold text-chassis-100">
      Точная стоимость — только после диагностики
    </h3>
    <p class="text-xs sm:text-sm text-chassis-300 leading-relaxed">
      В сложном компонентном ремонте невозможно назвать честную сумму без осмотра платы под микроскопом и замеров. Стоимость деталей зависит от модели ноутбука и наличия у поставщиков. Дефект определяем на диагностике и согласовываем смету до начала пайки.
    </p>
  </div>

  <!-- Step by step workflow -->
  <div class="space-y-4">
    <div class="text-xs font-sans text-chassis-400 uppercase tracking-wider">Как устроен процесс ремонта</div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
      {workflowSteps.map((item) => (
        <div class="space-y-1.5">
          <div class="text-xs font-sans text-chassis-400 font-bold">{item.step}</div>
          <h4 class="text-sm font-bold text-chassis-100">{item.title}</h4>
          <p class="text-xs text-chassis-400 leading-relaxed">{item.desc}</p>
        </div>
      ))}
    </div>
  </div>

  <!-- Direct Consultation Bar -->
  <div class="rounded-lg border border-chassis-800 bg-chassis-950 p-6 flex flex-col sm:flex-row items-center justify-between gap-4">
    <div class="text-xs text-chassis-300 space-y-1 text-center sm:text-left">
      <div class="font-bold text-chassis-100">Нужна консультация?</div>
      <div>Опишите симптомы дежурному мастеру для предварительной оценки.</div>
    </div>

    <div class="flex items-center gap-2">
      <IconLink
        type="telegram"
        href={siteConfig.telegram.masterUrl}
        label="Написать в Telegram"
        ariaLabel="Написать в Telegram"
        variant="button"
        target="_blank"
      />
      <IconLink
        type="phone"
        href={`tel:${siteConfig.phones.primary}`}
        label={siteConfig.phones.displayPrimary}
        ariaLabel="Позвонить"
        variant="button"
        class="border-chassis-700 bg-chassis-900 hover:bg-chassis-800 text-chassis-200"
      />
    </div>
  </div>

</div>