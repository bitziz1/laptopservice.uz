---
import { siteConfig } from "@/data/siteConfig";
import IconLink from "@/components/IconLink.astro";

const workflowSteps = [
  {
    step: "01",
    title: "Визит в сервисный центр",
    desc: "Привезите ноутбук лично на ул. Паркент 11. Диагностика — бесплатно. Это упор: сначала разбираемся, что с платой, без спешки и навязывания."
  },
  {
    step: "02",
    title: "Акт приёма и диагностика",
    desc: "Зачастую проблема неочевидна с первого взгляда. Оставляете устройство, фиксируем акт приёма и ваши контакты. На диагностику уходит время — проверяем замеры, сигналы, тепловизор."
  },
  {
    step: "03",
    title: "Звонок и согласование",
    desc: "Когда причина найдена, звоним по оставленному контакту, объясняем неисправность и согласуем стоимость. Только после вашего «да» мастер приступает к делу."
  },
  {
    step: "04",
    title: "Ремонт и стресс-тестирование",
    desc: "Пайка, замена чипов, чистка — с последующей обязательной проверкой под нагрузкой."
  },
  {
    step: "05",
    title: "Выдача и гарантия",
    desc: "Оплата — по факту выполненных работ. Даём гарантию сервисного центра."
  }
];
---

<div class="space-y-10">
  
  <!-- Diagnostic Principle Alert -->
  <div class="py-2 space-y-3">
    <div class="text-xs font-sans text-chassis-400 uppercase tracking-wider">Главный принцип — бесплатно и честно</div>
    <h3 class="text-lg sm:text-xl font-bold text-chassis-100">
      Бесплатная диагностика. Стоимость — только после неё
    </h3>
    <p class="text-xs sm:text-sm text-chassis-300 leading-relaxed">
      Привезите ноутбук — посмотрим плату под микроскопом, сделаем замеры и скажем честно, что случилось. Ничего не навязываем: стоимость деталей зависит от модели и наличия, озвучиваем её после диагностики и только с вашего согласия начинаем ремонт.
    </p>
  </div>

  <!-- Step by step workflow -->
  <div class="space-y-4">
    <div class="text-xs font-sans text-chassis-400 uppercase tracking-wider">Как устроен процесс ремонта</div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
      {workflowSteps.map((item) => (
        <div class="space-y-1.5">
          <div class="text-xs font-sans text-chassis-400 font-bold">{item.step}</div>
          <h4 class="text-sm font-bold text-chassis-100">{item.title}</h4>
          <p class="text-xs text-chassis-400 leading-relaxed">{item.desc}</p>
        </div>
      ))}
    </div>
  </div>

  <!-- Direct Consultation Bar -->
  <div class="rounded-lg border border-chassis-800 bg-chassis-950 p-6 flex flex-col sm:flex-row items-center justify-between gap-4">
    <div class="text-xs text-chassis-300 space-y-1 text-center sm:text-left">
      <div class="font-bold text-chassis-100">Нужна консультация?</div>
      <div>Опишите симптомы дежурному мастеру для предварительной оценки.</div>
    </div>

    <div class="flex items-center gap-2">
      <IconLink
        type="telegram"
        href={siteConfig.telegram.masterUrl}
        label="Написать в Telegram"
        ariaLabel="Написать в Telegram"
        variant="button"
        target="_blank"
      />
      <IconLink
        type="phone"
        href={`tel:${siteConfig.phones.primary}`}
        label={siteConfig.phones.displayPrimary}
        ariaLabel="Позвонить"
        variant="button"
        class="border-chassis-700 bg-chassis-900 hover:bg-chassis-800 text-chassis-200"
      />
    </div>
  </div>

</div>