---
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";
import { formatDateRu } from "@/utils/formatDate";

interface Props {
  caseItem: any;
}

const { caseItem } = Astro.props;
// Только MD коллекции: heroImage/gallery как ImageMetadata (оптимизируются в avif/webp)
let cardMeta: ImageMetadata | undefined;
const heroImage = (caseItem as any).heroImage as ImageMetadata | undefined;
const gallery = (caseItem as any).gallery as ImageMetadata[] | undefined;

if (heroImage) {
  cardMeta = heroImage;
} else if (gallery && gallery.length > 0) {
  cardMeta = gallery[0];
}
---

<article class="rounded-[14px] bg-chassis-850 border border-chassis-800 overflow-hidden flex flex-col justify-between">
  {cardMeta && (
    <div class="w-full bg-chassis-900 overflow-hidden">
      <Picture src={cardMeta} alt={caseItem.title} widths={[400, 600]} sizes="(max-width: 768px) 100vw, 400px" formats={["avif", "webp"]} fallbackFormat="webp" class="w-full h-[160px] object-cover" loading="lazy" decoding="async" />
    </div>
  )}
  <div class="p-5 sm:p-6 flex flex-col justify-between flex-1 space-y-4">
    <div class="space-y-3">
      <div class="flex items-center justify-between gap-2 text-[11px] font-sans">
        <span class="text-chassis-300 font-bold uppercase">{caseItem.category}</span>
        <time datetime={caseItem.date} class="text-chassis-400">{formatDateRu(caseItem.date)}</time>
      </div>

      <div class="text-xs font-sans text-chassis-400">Устройство: <span class="text-chassis-300 font-bold">{caseItem.device}</span></div>

      <h3 class="text-lg font-extrabold text-chassis-100 leading-tight line-clamp-2">
        <a href={`/cases/${caseItem.slug}`} class="hover:underline">
          {caseItem.title}
        </a>
      </h3>
    </div>

    <div class="flex items-center justify-between">
      <div class="flex flex-wrap gap-1">
        {caseItem.tags.slice(0, 2).map((tag: string) => (
          <span class="text-[11px] font-sans text-sky-400">
            #{tag}
          </span>
        ))}
      </div>

      <a
        href={`/cases/${caseItem.slug}`}
        class="text-xs font-sans font-bold text-chassis-200 hover:text-chassis-100 underline underline-offset-2"
      >
        Читать разбор →
      </a>
    </div>
  </div>

</article>