---
import type { CaseItem } from "@/data/cases";
import { formatDateRu } from "@/utils/formatDate";

interface Props {
  caseItem: CaseItem;
}

const { caseItem } = Astro.props;
---

<article class="rounded-lg bg-chassis-850/50 overflow-hidden flex flex-col justify-between">
  { (caseItem as any).image && (
    <div class="w-full bg-chassis-900">
      <img src={(caseItem as any).image} alt="" class="w-full h-auto object-contain max-h-48" loading="lazy" />
    </div>
  )}
  <div class="p-5 sm:p-6 flex flex-col justify-between flex-1 space-y-4">
    <div class="space-y-3">
      <div class="flex items-center justify-between gap-2 text-[11px] font-sans">
        <span class="text-chassis-300 font-bold uppercase">{caseItem.category}</span>
        <time datetime={caseItem.date} class="text-chassis-400">{formatDateRu(caseItem.date)}</time>
      </div>

      <div class="text-xs font-sans text-chassis-400">Устройство: <span class="text-chassis-300 font-bold">{caseItem.device}</span></div>

      <h3 class="text-lg font-extrabold text-chassis-100 leading-tight line-clamp-2">
        <a href={`/cases/${caseItem.slug}`} class="hover:underline">
          {caseItem.title}
        </a>
      </h3>

      <p class="text-xs text-chassis-400 line-clamp-2 leading-relaxed">
        <span class="text-chassis-300 font-medium">Симптом:</span> {caseItem.problem}
      </p>

      <p class="text-xs text-chassis-400 line-clamp-2 leading-relaxed">
        <span class="text-chassis-300 font-medium">Решение:</span> {caseItem.solution.split("\n")[0]}
      </p>
    </div>

    <div class="flex items-center justify-between">
      <div class="flex flex-wrap gap-1">
        {caseItem.tags.slice(0, 2).map((tag) => (
          <span class="text-[11px] font-sans text-sky-400">
            #{tag}
          </span>
        ))}
      </div>

      <a
        href={`/cases/${caseItem.slug}`}
        class="text-xs font-sans font-bold text-chassis-200 hover:text-chassis-100 underline underline-offset-2"
      >
        Читать разбор →
      </a>
    </div>
  </div>

</article>