---
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";
import { formatDateRu } from "@/utils/formatDate";

interface Props {
  build: any;
}

const { build } = Astro.props;

const purposeColor: Record<string, string> = {
  gaming: "text-chassis-400",
  "ai-work": "text-chassis-400",
  office: "text-chassis-400",
  rendering: "text-chassis-400",
};

let buildMeta: ImageMetadata | undefined;
const heroImage = (build as any).heroImage as ImageMetadata | undefined;
const gallery = (build as any).gallery as ImageMetadata[] | undefined;
if (heroImage) {
  buildMeta = heroImage;
} else if (gallery && gallery.length > 0) {
  buildMeta = gallery[0];
}
const dateStr = typeof build.date === "string" ? build.date : build.date instanceof Date ? build.date.toISOString().slice(0,10) : String(build.date);
---

<article class="rounded-lg bg-chassis-850/50 overflow-hidden flex flex-col justify-between">
  {buildMeta && (
    <div class="w-full bg-chassis-900">
      <Picture src={buildMeta} alt={build.title} widths={[400, 600]} sizes="(max-width: 768px) 100vw, 400px" formats={["avif", "webp"]} fallbackFormat="webp" class="w-full h-auto object-contain max-h-48" loading="lazy" decoding="async" />
    </div>
  )}
  <div class="p-5 sm:p-6 flex flex-col justify-between flex-1 space-y-4">
    <div class="space-y-3">
      <div class="flex items-center justify-between gap-2">
        <span class={`text-[11px] font-sans font-bold uppercase tracking-wider ${purposeColor[build.purpose] ?? "text-chassis-400"}`}>
          {build.purposeLabel}
        </span>
        <span class="text-[11px] font-sans text-chassis-400">{formatDateRu(dateStr)}</span>
      </div>

      <h3 class="text-lg font-extrabold text-chassis-100 leading-tight line-clamp-2">
        <a href={`/builds/${build.slug}`} class="hover:underline">
          {build.title}
        </a>
      </h3>

      <p class="text-xs text-chassis-400 line-clamp-3 leading-relaxed">
        {build.description}
      </p>

      <div class="grid grid-cols-1 gap-1.5 pt-1 text-xs font-mono">
        {build.components.cpu && <div class="flex gap-1.5"><span class="text-chassis-400 shrink-0">CPU:</span><span class="text-chassis-300 line-clamp-1">{build.components.cpu}</span></div>}
        {build.components.gpu && <div class="flex gap-1.5"><span class="text-chassis-400 shrink-0">GPU:</span><span class="text-chassis-300 line-clamp-1">{build.components.gpu}</span></div>}
        {build.components.ram && <div class="flex gap-1.5"><span class="text-chassis-400 shrink-0">RAM:</span><span class="text-chassis-300 line-clamp-1">{build.components.ram}</span></div>}
        {build.components.storage && <div class="flex gap-1.5"><span class="text-chassis-400 shrink-0">Накопитель:</span><span class="text-chassis-300 line-clamp-1">{build.components.storage}</span></div>}
      </div>
    </div>

    <div class="flex items-center justify-between">
      <div class="flex flex-wrap gap-1">
        {build.tags.slice(0, 2).map((tag: string) => (
          <span class="text-[11px] font-sans text-sky-400">
            #{tag}
          </span>
        ))}
      </div>
      <a href={`/builds/${build.slug}`} class="text-xs font-sans text-chassis-200 hover:text-chassis-100 underline underline-offset-2">
        Смотреть характеристики →
      </a>
    </div>
  </div>
</article>
