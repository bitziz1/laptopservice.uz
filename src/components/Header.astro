---
import { siteConfig } from "@/data/siteConfig";
import IconLink from "@/components/IconLink.astro";

interface Props {
  currentPath?: string;
}

const { currentPath = "" } = Astro.props;

const navItems = [
  { href: "/services", label: "Услуги" },
  { href: "/builds", label: "Сборки ПК" },
  { href: "/cases", label: "Наши работы" },
  { href: "/prices", label: "Диагностика и цены" },
  { href: "/reviews", label: "Отзывы" },
  { href: "/contacts", label: "Контакты" },
];
---

<header class="sticky top-0 z-50 w-full border-b border-chassis-800 bg-chassis-900/95 backdrop-blur-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 sm:h-18">
      
      <!-- Brand Logo / Identity -->
      <a href="/" class="flex items-center gap-2.5 focus:outline-none" aria-label="Laptop Service — на главную">
        <img
          src="/logo.svg"
          alt="Laptop Service"
          width="32"
          height="32"
          class="w-8 h-8"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
        <div class="hidden min-[480px]:flex flex-col">
          <span class="font-bold text-sm sm:text-base tracking-wider text-chassis-100 uppercase">Laptop Service</span>
          <span class="text-[11px] text-chassis-400 font-sans">ул. Паркент 11 • Ташкент</span>
        </div>
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden lg:flex items-center gap-1" aria-label="Основная навигация">
        {navItems.map((item) => {
          const isActive = item.href === "/" ? currentPath === "/" || currentPath === "" : currentPath.startsWith(item.href);
          return (
            <a
              href={item.href}
              class={`px-3 py-1.5 rounded text-xs font-sans uppercase tracking-wider transition-colors ${
                isActive
                  ? "text-chassis-100 bg-chassis-800 font-bold border border-chassis-700"
                  : "text-chassis-400 hover:text-chassis-200 hover:bg-chassis-850"
              }`}
            >
              {item.label}
            </a>
          );
        })}
      </nav>

      <div class="flex items-center gap-1.5">
        <!-- 1 кнопка с 2 иконками (ТГ + телефон) — только <640 -->
        <div class="flex sm:hidden items-center rounded border border-chassis-700 bg-chassis-850 overflow-hidden">
          <a href={siteConfig.telegram.masterUrl} aria-label="Написать в Telegram" target="_blank" rel="noopener noreferrer" class="flex items-center gap-1.5 px-3 py-1.5 hover:bg-chassis-800 transition-colors">
            <img src="/Telegram_Logo.svg" alt="" width="16" height="16" class="w-4 h-4 object-contain" loading="lazy" />
            <span class="text-[11px] font-medium text-chassis-200 whitespace-nowrap">@laptopservice_uz</span>
          </a>
          <div class="w-px h-5 bg-chassis-700 shrink-0"></div>
          <a href={`tel:${siteConfig.phones.primary}`} aria-label="Позвонить" class="flex items-center gap-1.5 px-3 py-1.5 hover:bg-chassis-800 transition-colors">
            <img src="/phone.svg" alt="" width="16" height="16" class="w-4 h-4 object-contain" loading="lazy" />
            <span class="text-[11px] font-bold text-chassis-100 whitespace-nowrap">(93) 228-77-38</span>
          </a>
        </div>

        <!-- Desktop/tablet actions — от 640, как было раньше -->
        <div class="hidden sm:flex items-center gap-2.5">
          <IconLink
            type="telegram"
            href={siteConfig.telegram.masterUrl}
            label="Telegram"
            ariaLabel="Написать в Telegram {siteConfig.telegram.masterHandle}"
            variant="button"
            target="_blank"
          />

          <IconLink
            type="phone"
            href={`tel:${siteConfig.phones.primary}`}
            label={siteConfig.phones.displayPrimary}
            ariaLabel="Позвонить"
            variant="button"
            class="border-chassis-600 bg-chassis-800 hover:bg-chassis-700 text-chassis-100 font-bold"
          />
        </div>

        <!-- Burger — виден до 1024, скрыт на lg -->
        <button
          type="button"
          id="mobile-menu-toggle"
          class="flex lg:hidden p-2 rounded border border-chassis-800 text-chassis-400 hover:text-chassis-100"
          aria-label="Открыть меню"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Drawer Menu — только разделы, виден до lg -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-chassis-800 bg-chassis-950 px-4 py-4 space-y-2">
    {navItems.map((item) => {
      const isActive = item.href === "/" ? currentPath === "/" || currentPath === "" : currentPath.startsWith(item.href);
      return (
        <a
          href={item.href}
          class={`block px-3 py-2 rounded text-xs font-sans uppercase tracking-wider ${
            isActive ? "bg-chassis-800 text-chassis-100 font-bold" : "text-chassis-400 hover:text-chassis-200"
          }`}
        >
          {item.label}
        </a>
      );
    })}
  </div>
</header>

<script>
  const toggleBtn = document.getElementById("mobile-menu-toggle");
  const mobileMenu = document.getElementById("mobile-menu");
  if (toggleBtn && mobileMenu) {
    toggleBtn.addEventListener("click", () => {
      const isHidden = mobileMenu.classList.toggle("hidden");
      toggleBtn.setAttribute("aria-expanded", String(!isHidden));
    });
  }
</script>