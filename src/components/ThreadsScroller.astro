---
import { Picture } from "astro:assets";
import { getCollection } from "astro:content";
import { formatThreadsDate } from "@/utils/formatDate";
import { siteConfig } from "@/data/siteConfig";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;

// Obsidian MD в content/threads/*.md — 1 файл = 1 пост, gallery рядом
const threads = await getCollection("threads");
threads.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

// helper для галереи
function galleryWithAlts(entry: (typeof threads)[number]) {
  const imgs = entry.data.gallery ?? [];
  const alts = entry.data.alts ?? [];
  return imgs.map((img, i) => ({ img, alt: alts[i] ?? entry.body?.slice(0, 80) ?? "" }));
}
---

<div class={`threads-wrap ${className ?? ""}`}>

  <div class="flex items-center justify-between mb-2 px-1 gap-2">
    <h2 class="text-xs font-sans text-chassis-400 uppercase tracking-wider">Последние обновления</h2>
  </div>

  <div
    id="threads-scroller"
    class="threads-scroller flex gap-2 overflow-x-auto overflow-y-hidden pb-1 snap-x snap-mandatory scroll-smooth -mx-4 px-4 sm:mx-0 sm:px-0"
  >
    {threads.map((entry, idx) => {
      const gallery = galleryWithAlts(entry);
      const dateIso = entry.data.date.toISOString().slice(0, 10);
      const dateLabel = formatThreadsDate(dateIso);
      const handle = entry.data.handle ?? "laptopservice_uz";
      const text = entry.body?.trim() ?? "";
      const postUrl = (entry.data as any).url ?? siteConfig.telegram.channelUrl;
      return (
        <a
          href={postUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="threads-card shrink-0 snap-start w-[260px] sm:w-[300px] bg-chassis-850 border border-chassis-800 rounded-[14px] overflow-hidden flex flex-col hover:border-chassis-700 hover:bg-chassis-800/60 transition-colors text-left no-underline"
          data-thread-id={entry.id}
          data-thread-text={text}
          data-thread-url={postUrl}
          aria-label={`${handle} — ${text.slice(0,60)}`}
        >
          {/* Header — компактный, без ⋯ */}
          <div class="flex items-center gap-2 p-2.5 pb-1.5">
            <img src="/logo.svg" alt="Laptop Service" width="24" height="24" class="w-6 h-6 rounded-full bg-chassis-900 border border-chassis-800 shrink-0" loading="lazy" />
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-1 flex-wrap leading-none">
                <span class="text-xs font-bold text-chassis-100 leading-none">{handle}</span>
                <span class="inline-flex items-center justify-center w-3 h-3 rounded-full bg-sky-500 text-white text-[8px] leading-none">✓</span>
                <span class="text-chassis-500 text-[11px]">·</span>
                <time datetime={dateIso} class="text-[11px] text-chassis-400 font-sans">{dateLabel}</time>
              </div>
              <div class="text-[10px] text-chassis-500 font-sans leading-none mt-0.5">Laptop Service · Ташкент</div>
            </div>
          </div>

          {/* Text — 2 строки максимум для экономии высоты */}
          <div class="px-2.5 pb-1.5">
            <p class="text-xs text-chassis-200 leading-[1.4] whitespace-pre-wrap break-words line-clamp-3">{text}</p>
          </div>

          {/* Media — строго из content/threads/*.md gallery (оригиналы jpg/png) */}
          {gallery.length === 1 ? (
            <div class="px-2.5 pb-2.5">
              <div class="rounded-lg overflow-hidden border border-chassis-800 bg-chassis-900">
                <Picture
                  src={gallery[0].img}
                  alt={gallery[0].alt}
                  widths={[320, 560]}
                  sizes="(max-width: 640px) 260px, 300px"
                  formats={["avif", "webp"]}
                  fallbackFormat="webp"
                  loading={idx === 0 ? "eager" : "lazy"}
                  decoding="async"
                  fetchpriority={idx === 0 ? "high" : "low"}
                  class="w-full h-[148px] object-cover bg-chassis-900"
                />
              </div>
            </div>
          ) : gallery.length > 1 ? (
            <div class="px-2.5 pb-2.5">
              <div class="grid grid-cols-2 gap-1.5">
                {gallery.map(({ img, alt }) => (
                  <div class="rounded-lg overflow-hidden border border-chassis-800 bg-chassis-900">
                    <Picture
                      src={img}
                      alt={alt}
                      widths={[140, 280]}
                      sizes="(max-width: 640px) 128px, 138px"
                      formats={["avif", "webp"]}
                      fallbackFormat="webp"
                      loading="lazy"
                      decoding="async"
                      class="w-full h-[110px] object-cover"
                    />
                  </div>
                ))}
              </div>
            </div>
          ) : null}
        </a>
      );
    })}
  </div>

  <!-- Floating sticker — привязан к карточке, остаётся при скролле/свайпе -->
  <a id="thread-sticker" href={siteConfig.socials.threads} target="_blank" rel="noopener noreferrer" class="hidden fixed z-50 px-3 py-1.5 rounded-full bg-black/70 backdrop-blur-md border border-white/20 text-white text-xs font-bold shadow-lg whitespace-nowrap opacity-0 scale-90 transition-all duration-200 pointer-events-auto will-change-transform" style="transform: translate(-50%, -50%);" aria-hidden="true">
    Публикация &gt;
  </a>
</div>

<style>
  .threads-scroller {
    scrollbar-width: none;
    -ms-overflow-style: none;
    -webkit-overflow-scrolling: touch;
  }
  .threads-scroller::-webkit-scrollbar { display: none; }
  /* full-width: no max-width constraint */
  @media (prefers-reduced-motion: reduce) {
    .threads-scroller { scroll-behavior: auto; }
  }
</style>

<script>
  const scroller = document.getElementById('threads-scroller');
  const sticker = document.getElementById('thread-sticker') as HTMLElement | null;

  let anchorCard: HTMLElement | null = null;
  let relX = 0;
  let relY = 0;
  let hideTimer: number | null = null;
  let switchTimer: number | null = null;
  let rafId: number | null = null;

  function isStickerVisible() {
    return !!sticker && !sticker.classList.contains('hidden') && anchorCard !== null;
  }

  function syncPosition() {
    if (!sticker || !anchorCard) return;
    if (sticker.classList.contains('hidden')) return;
    const rect = anchorCard.getBoundingClientRect();
    // если карточка полностью вне вьюпорта — можно оставить позицию (уедет за экран вместе с карточкой)
    sticker.style.left = (rect.left + relX) + 'px';
    sticker.style.top = (rect.top + relY) + 'px';
  }

  function scheduleSync() {
    if (rafId !== null) return;
    rafId = requestAnimationFrame(() => {
      rafId = null;
      syncPosition();
    });
  }

  function showAtAnchor(card: HTMLElement, clientX: number, clientY: number) {
    if (!sticker) return;
    // Обновляем ссылку стикера под конкретную публикацию
    const threadUrl = (card as HTMLElement).dataset.threadUrl;
    if (threadUrl) (sticker as HTMLAnchorElement).href = threadUrl;
    const rect = card.getBoundingClientRect();
    // координаты внутри карточки
    relX = clientX - rect.left;
    relY = clientY - rect.top;
    // кламп внутри карточки (чтобы стикер не улетал далеко за границы при клике на padding)
    relX = Math.max(8, Math.min(rect.width - 8, relX));
    relY = Math.max(8, Math.min(rect.height - 8, relY));

    const isSameCard = anchorCard === card;
    const wasVisible = isStickerVisible();

    // если переключаемся на другую карточку — быстро скрываем предыдущий стикер, затем показываем на новой
    if (wasVisible && !isSameCard) {
      if (switchTimer !== null) clearTimeout(switchTimer);
      if (hideTimer !== null) clearTimeout(hideTimer);
      // быстрый фейд-аут предыдущего
      sticker.style.transitionDuration = '120ms';
      sticker.classList.add('opacity-0', 'scale-90');
      sticker.classList.remove('opacity-100', 'scale-100');
      // после короткого исчезновения — перемещаем к новой карточке и показываем
      switchTimer = window.setTimeout(() => {
        anchorCard = card;
        syncPosition();
        sticker.classList.remove('hidden');
        sticker.setAttribute('aria-hidden', 'false');
        // форсим reflow перед показом
        void sticker.offsetWidth;
        sticker.style.transitionDuration = '200ms';
        requestAnimationFrame(() => {
          if (!sticker) return;
          sticker.classList.remove('opacity-0', 'scale-90');
          sticker.classList.add('opacity-100', 'scale-100');
        });
      }, 130);
      return;
    }

    anchorCard = card;
    if (hideTimer !== null) { clearTimeout(hideTimer); hideTimer = null; }
    if (switchTimer !== null) { clearTimeout(switchTimer); switchTimer = null; }

    syncPosition();
    sticker.classList.remove('hidden');
    sticker.setAttribute('aria-hidden', 'false');
    sticker.style.transitionDuration = '200ms';
    requestAnimationFrame(() => {
      if (!sticker) return;
      sticker.classList.remove('opacity-0', 'scale-90');
      sticker.classList.add('opacity-100', 'scale-100');
    });
  }

  function hideSticker() {
    if (!sticker) return;
    if (sticker.classList.contains('hidden')) return;
    if (switchTimer !== null) { clearTimeout(switchTimer); switchTimer = null; }
    if (hideTimer !== null) clearTimeout(hideTimer);
    sticker.style.transitionDuration = '200ms';
    sticker.classList.add('opacity-0', 'scale-90');
    sticker.classList.remove('opacity-100', 'scale-100');
    hideTimer = window.setTimeout(() => {
      if (!sticker) return;
      sticker.classList.add('hidden');
      sticker.setAttribute('aria-hidden', 'true');
      anchorCard = null;
    }, 200);
  }

  if (scroller && sticker) {
    scroller.addEventListener('click', (e) => {
      const card = (e.target as HTMLElement).closest('.threads-card') as HTMLElement | null;
      if (!card) {
        hideSticker();
        return;
      }
      // second click on same card while sticker visible → allow native navigation to post
      if (isStickerVisible() && anchorCard === card) {
        hideSticker();
        return; // don't preventDefault, follow <a href>
      }
      e.preventDefault();
      const x = (e as MouseEvent).clientX;
      const y = (e as MouseEvent).clientY;
      showAtAnchor(card, x, y);
    });
    scroller.addEventListener('touchend', (e) => {
      const card = (e.target as HTMLElement).closest('.threads-card') as HTMLElement | null;
      if (!card) return;
      // if sticker already on this card, let click handler handle navigation
      if (isStickerVisible() && anchorCard === card) return;
      const touch = (e as TouchEvent).changedTouches[0];
      if (!touch) return;
      // prevent synthetic click -> show sticker only
      e.preventDefault();
      showAtAnchor(card, touch.clientX, touch.clientY);
    }, { passive: false });
    // клик вне — скрыть
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (!target.closest('.threads-card') && !target.closest('#thread-sticker')) {
        hideSticker();
      }
    });
    // Скролл/свайп — НЕ скрываем, а привязываем позицию к карточке
    scroller.addEventListener('scroll', scheduleSync, { passive: true });
    window.addEventListener('scroll', scheduleSync, { passive: true });
    window.addEventListener('resize', scheduleSync);
    // если карточка меняет размер — синхронизируем
    const ro = new ResizeObserver(scheduleSync);
    if (scroller) ro.observe(scroller);

    // клик по стикеру — переход (естественный), скрыть после
    sticker.addEventListener('click', () => {
      setTimeout(hideSticker, 100);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') hideSticker();
    });
  }
</script>
