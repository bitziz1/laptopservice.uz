---
import { Picture } from "astro:assets";
import { getCollection } from "astro:content";
import { formatThreadsDate } from "@/utils/formatDate";
import { siteConfig } from "@/data/siteConfig";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;

// Obsidian MD в content/threads/*.md — 1 файл = 1 пост, gallery рядом
const threads = await getCollection("threads");
threads.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

// helper для галереи
function galleryWithAlts(entry: (typeof threads)[number]) {
  const imgs = entry.data.gallery ?? [];
  const alts = entry.data.alts ?? [];
  return imgs.map((img, i) => ({ img, alt: alts[i] ?? entry.body?.slice(0, 80) ?? "" }));
}
---

<div class={`threads-wrap ${className ?? ""}`}>

  <div class="flex items-center justify-between mb-2 px-1 gap-2">
    <h2 class="text-xs font-sans text-chassis-400 uppercase tracking-wider">Последние обновления</h2>
  </div>

  <div class="relative">
    <!-- Desktop scroll buttons — по бокам -->
    <button
      id="threads-prev"
      type="button"
      aria-label="Прокрутить назад"
      class="hidden md:flex absolute left-1 lg:-left-4 top-1/2 -translate-y-1/2 z-10 w-9 h-9 items-center justify-center rounded-full bg-black/70 backdrop-blur-md border border-white/15 text-white hover:bg-black/85 transition shadow-lg disabled:opacity-30 disabled:pointer-events-none"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
    </button>
    <button
      id="threads-next"
      type="button"
      aria-label="Прокрутить вперед"
      class="hidden md:flex absolute right-1 lg:-right-4 top-1/2 -translate-y-1/2 z-10 w-9 h-9 items-center justify-center rounded-full bg-black/70 backdrop-blur-md border border-white/15 text-white hover:bg-black/85 transition shadow-lg disabled:opacity-30 disabled:pointer-events-none"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
    </button>

    <div
      id="threads-scroller"
      class="threads-scroller flex gap-2 overflow-x-auto overflow-y-hidden pb-1 snap-x snap-mandatory scroll-smooth -mx-4 px-4 sm:mx-0 sm:px-0"
    >
      {threads.map((entry, idx) => {
        const gallery = galleryWithAlts(entry);
        const dateIso = entry.data.date.toISOString().slice(0, 10);
        const dateLabel = formatThreadsDate(dateIso);
        const handle = entry.data.handle ?? "laptopservice_uz";
        const text = entry.body?.trim() ?? "";
        const postUrl = (entry.data as any).url ?? siteConfig.telegram.channelUrl;
        const videoUrl = (entry.data as any).video as string | undefined;
        const videoPoster = videoUrl ? videoUrl.replace(/\.mp4$/, ".jpg") : undefined;
        const hasVideo = !!videoUrl;
        return (
          <a
            href={postUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="threads-card shrink-0 snap-start w-[260px] sm:w-[300px] bg-chassis-850 border border-chassis-800 rounded-[14px] overflow-hidden flex flex-col hover:border-chassis-700 hover:bg-chassis-800/60 transition-colors text-left no-underline"
            aria-label={`${handle} — ${text.slice(0,60)}`}
          >
            {/* Header — компактный, без ⋯ */}
            <div class="flex items-center gap-2 p-2.5 pb-1.5">
              <img src="/logo.svg" alt="Laptop Service" width="24" height="24" class="w-6 h-6 rounded-full bg-chassis-900 border border-chassis-800 shrink-0" loading="lazy" />
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-1 flex-wrap leading-none">
                  <span class="text-xs font-bold text-chassis-100 leading-none">{handle}</span>
                  <span class="inline-flex items-center justify-center w-3 h-3 rounded-full bg-sky-500 text-white text-[8px] leading-none">✓</span>
                  <span class="text-chassis-500 text-[11px]">·</span>
                  <time datetime={dateIso} class="text-[11px] text-chassis-400 font-sans">{dateLabel}</time>
                </div>
                <div class="text-[10px] text-chassis-500 font-sans leading-none mt-0.5">Laptop Service · Ташкент</div>
              </div>
            </div>

            {/* Text — 2 строки максимум для экономии высоты */}
            <div class="px-2.5 pb-1.5">
              <p class="text-xs text-chassis-200 leading-[1.4] whitespace-pre-wrap break-words line-clamp-3">{text}</p>
            </div>

            {/* Media — квадрат 1:1, центр-кроп, autoplay везде */}
            {hasVideo ? (
              <div class="px-2.5 pb-2.5">
                <div class="rounded-lg overflow-hidden border border-chassis-800 bg-chassis-900 relative aspect-square">
                  <video
                    src={videoUrl}
                    poster={videoPoster}
                    autoplay
                    muted
                    loop
                    playsinline
                    webkit-playsinline
                    x-webkit-airplay="deny"
                    disablepictureinpicture
                    disableremoteplayback
                    preload="auto"
                    aria-label={gallery[0]?.alt ?? text.slice(0, 80)}
                    class="threads-video w-full h-full object-cover object-center bg-chassis-900 pointer-events-none"
                  />
                  <span class="absolute bottom-1.5 right-1.5 bg-black/60 backdrop-blur-sm text-white text-[10px] px-1.5 py-0.5 rounded-full flex items-center gap-1 pointer-events-none">
                    <svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5.14v14l11-7z"/></svg> 0:05
                  </span>
                </div>
              </div>
            ) : gallery.length === 1 ? (
              <div class="px-2.5 pb-2.5">
                <div class="rounded-lg overflow-hidden border border-chassis-800 bg-chassis-900 aspect-square">
                  <Picture
                    src={gallery[0].img}
                    alt={gallery[0].alt}
                    widths={[320, 560]}
                    sizes="(max-width: 640px) 260px, 300px"
                    formats={["avif", "webp"]}
                    fallbackFormat="webp"
                    loading={idx === 0 ? "eager" : "lazy"}
                    decoding="async"
                    fetchpriority={idx === 0 ? "high" : "low"}
                    class="w-full h-full object-cover object-center bg-chassis-900"
                  />
                </div>
              </div>
            ) : gallery.length > 1 ? (
              <div class="px-2.5 pb-2.5">
                <div class="grid grid-cols-2 gap-1.5">
                  {gallery.map(({ img, alt }) => (
                    <div class="rounded-lg overflow-hidden border border-chassis-800 bg-chassis-900 aspect-square">
                      <Picture
                        src={img}
                        alt={alt}
                        widths={[260, 360]}
                        sizes="(max-width: 640px) 128px, 146px"
                        formats={["avif", "webp"]}
                        fallbackFormat="webp"
                        loading="lazy"
                        decoding="async"
                        class="w-full h-full object-cover object-center"
                      />
                    </div>
                  ))}
                </div>
              </div>
            ) : null}
          </a>
        );
      })}
    </div>
  </div>
</div>

<style>
  .threads-scroller {
    scrollbar-width: none;
    -ms-overflow-style: none;
    -webkit-overflow-scrolling: touch;
  }
  .threads-scroller::-webkit-scrollbar { display: none; }
  @media (prefers-reduced-motion: reduce) {
    .threads-scroller { scroll-behavior: auto; }
  }
  /* hide native play overlay on mobile when autoplay */
  .threads-video::-webkit-media-controls-start-playback-button { display: none; -webkit-appearance: none; }
</style>

<script>
  const scroller = document.getElementById('threads-scroller') as HTMLElement | null;
  const prevBtn = document.getElementById('threads-prev') as HTMLButtonElement | null;
  const nextBtn = document.getElementById('threads-next') as HTMLButtonElement | null;

  function updateButtons() {
    if (!scroller || !prevBtn || !nextBtn) return;
    const { scrollLeft, scrollWidth, clientWidth } = scroller;
    const atStart = scrollLeft <= 4;
    const atEnd = scrollLeft + clientWidth >= scrollWidth - 4;
    prevBtn.disabled = atStart;
    nextBtn.disabled = atEnd;
    // скрываем обе если контента не хватает для прокрутки
    const needScroll = scrollWidth > clientWidth + 8;
    prevBtn.style.display = needScroll ? '' : 'none';
    nextBtn.style.display = needScroll ? '' : 'none';
    // на мобилке скрыты через md:flex, но на десктопе нужна проверка
    if (needScroll && window.innerWidth >= 768) {
      prevBtn.classList.remove('hidden');
      nextBtn.classList.remove('hidden');
      prevBtn.classList.add('md:flex');
      nextBtn.classList.add('md:flex');
    }
  }

  function scrollByAmount(dir: number) {
    if (!scroller) return;
    const card = scroller.querySelector('.threads-card') as HTMLElement | null;
    const gap = 8;
    const amount = card ? card.offsetWidth + gap : scroller.clientWidth * 0.8;
    scroller.scrollBy({ left: dir * amount, behavior: 'smooth' });
  }

  if (scroller && prevBtn && nextBtn) {
    prevBtn.addEventListener('click', () => scrollByAmount(-1));
    nextBtn.addEventListener('click', () => scrollByAmount(1));
    scroller.addEventListener('scroll', updateButtons, { passive: true });
    window.addEventListener('resize', updateButtons);
    // ResizeObserver для актуализации после загрузки картинок
    const ro = new ResizeObserver(updateButtons);
    ro.observe(scroller);
    // init
    requestAnimationFrame(() => {
      // небольшая задержка чтобы картинки прогрузились и scrollWidth стал корректным
      setTimeout(updateButtons, 100);
      updateButtons();
    });
  }

  // Autoplay threads videos everywhere (incl. iOS) — force muted play + IntersectionObserver
  (function () {
    const videos = document.querySelectorAll<HTMLVideoElement>('.threads-video');
    if (!videos.length) return;
    const tryPlay = (v: HTMLVideoElement) => {
      v.muted = true;
      v.defaultMuted = true;
      // @ts-ignore
      v.playsInline = true;
      const p = v.play();
      if (p && typeof p.catch === 'function') p.catch(() => {});
    };
    // initial attempt after metadata
    videos.forEach((v) => {
      if (v.readyState >= 1) tryPlay(v);
      else v.addEventListener('loadedmetadata', () => tryPlay(v), { once: true });
      v.addEventListener('canplay', () => tryPlay(v), { once: true });
    });
    // retry on first user interaction (iOS low-power)
    const onFirstInteract = () => {
      videos.forEach(tryPlay);
      window.removeEventListener('touchstart', onFirstInteract);
      window.removeEventListener('click', onFirstInteract);
    };
    window.addEventListener('touchstart', onFirstInteract, { once: true, passive: true });
    window.addEventListener('click', onFirstInteract, { once: true });
    // pause offscreen, play onscreen to save battery
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            const v = e.target as HTMLVideoElement;
            if (e.isIntersecting) tryPlay(v);
            else v.pause();
          });
        },
        { threshold: 0.25 },
      );
      videos.forEach((v) => io.observe(v));
    }
    // also retry after visibility change
    document.addEventListener('visibilitychange', () => {
      if (!document.hidden) videos.forEach(tryPlay);
    });
  })();
</script>
