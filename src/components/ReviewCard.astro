---
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  review: any;
}

const { review } = Astro.props;

let galleryMeta: ImageMetadata[] = (review as any).gallery as ImageMetadata[] ?? [];
let galleryCaptions: string[] = (review as any).captions as string[] ?? [];
---

<div class="rounded-lg bg-chassis-850/50 p-5 sm:p-6 flex flex-col justify-between space-y-4">
  
  <div class="space-y-3">
    <div class="flex items-center justify-between gap-2 pb-3">
      <div>
        <h4 class="font-bold text-chassis-100 text-sm">{review.author}</h4>
        <p class="text-[11px] text-chassis-400 font-sans">Устройство: {review.device}</p>
      </div>

      <span class="text-[10px] font-sans text-chassis-400">
        {review.source}
      </span>
    </div>

    <div class="flex items-center gap-1 text-xs text-chassis-300 font-sans">
      <span>★★★★★</span>
      <span class="text-chassis-400 ml-1">{review.date}</span>
    </div>

    <p class="text-xs sm:text-sm text-chassis-300 leading-relaxed italic">
      «{review.text}»
    </p>

    <!-- Фото — оптимизируются в avif/webp -->
    {galleryMeta.length > 0 && (
      <div class="pt-2 space-y-2">
        <div class="text-[10px] font-sans uppercase text-chassis-400">Фото ремонта / устройства:</div>
        <div class="grid grid-cols-1 gap-2">
          {galleryMeta.map((img, idx) => (
            <div class="rounded-lg overflow-hidden border border-chassis-800 bg-chassis-900">
              <Picture src={img} alt={galleryCaptions[idx] || `Фото #${idx+1}`} widths={[300, 600]} sizes="(max-width: 768px) 100vw, 400px" formats={["avif", "webp"]} fallbackFormat="webp" class="w-full h-auto object-cover max-h-48" loading="lazy" decoding="async" />
              {galleryCaptions[idx] && <div class="text-[10px] font-sans text-chassis-500 p-1.5 truncate">{galleryCaptions[idx]}</div>}
            </div>
          ))}
        </div>
      </div>
    )}
  </div>

  {review.masterReply && (
    <div class="pt-3 text-xs text-chassis-400 space-y-1">
      <span class="text-chassis-300 font-sans font-bold block">Ответ:</span>
      <p class="italic leading-relaxed">{review.masterReply}</p>
    </div>
  )}

</div>