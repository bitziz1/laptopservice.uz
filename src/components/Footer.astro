---
import { siteConfig } from "@/data/siteConfig";
import { servicesData } from "@/data/services";

const currentYear = new Date().getFullYear();
---

<footer class="mt-auto border-t border-chassis-800 bg-chassis-950 text-chassis-400">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
      
      <!-- Col 1: Identity & Terms -->
      <div class="space-y-3">
        <div class="flex items-center gap-2">
          <span class="font-bold text-sm text-chassis-100 uppercase tracking-wider font-mono">Laptop Service</span>
        </div>
        <p class="text-xs leading-relaxed text-chassis-400">
          Сервисный центр по ремонту ноутбуков и компьютерной техники в Ташкенте. Компонентный ремонт, BGA-пайка, восстановление после залития.
        </p>
        <p class="text-xs text-chassis-300 font-mono border-l border-chassis-700 pl-2 mt-2">
          Стоимость ремонта всегда согласуется с клиентом строго до начала работ.
        </p>
      </div>

      <!-- Col 2: Services -->
      <div>
        <h3 class="text-xs font-mono font-bold text-chassis-200 uppercase tracking-wider mb-3">Услуги</h3>
        <ul class="space-y-2 text-xs">
          {servicesData.map((service) => (
            <li>
              <a href={`/services/${service.slug}`} class="hover:text-chassis-100 transition-colors">
                {service.title}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 3: Navigation & Channels -->
      <div>
        <h3 class="text-xs font-mono font-bold text-chassis-200 uppercase tracking-wider mb-3">Контакты и каналы</h3>
        <ul class="space-y-2 text-xs font-mono">
          <li>
            <a href={`tel:${siteConfig.phones.primary}`} class="text-chassis-200 hover:text-chassis-100 font-bold">
              {siteConfig.phones.displayPrimary} (Звонок)
            </a>
          </li>
          <li>
            <a href={siteConfig.telegram.masterUrl} target="_blank" rel="noopener noreferrer" class="hover:text-chassis-100">
              Telegram мастера: {siteConfig.telegram.masterHandle}
            </a>
          </li>
          <li>
            <a href={siteConfig.telegram.channelUrl} target="_blank" rel="noopener noreferrer" class="hover:text-chassis-100">
              Telegram канал: @laptopservice_uz
            </a>
          </li>
          <li>
            <a href={siteConfig.telegram.chatUrl} target="_blank" rel="noopener noreferrer" class="hover:text-chassis-100">
              Telegram чат мастеров
            </a>
          </li>
          <li>
            <a href={siteConfig.socials.instagram} target="_blank" rel="noopener noreferrer" class="hover:text-chassis-100">
              Instagram: laptopservice_uz
            </a>
          </li>
          <li>
            <a href={siteConfig.socials.facebook} target="_blank" rel="noopener noreferrer" class="hover:text-chassis-100">
              Facebook: RemontNoutbukov.uz
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 4: Address & Maps -->
      <div class="space-y-3">
        <h3 class="text-xs font-mono font-bold text-chassis-200 uppercase tracking-wider mb-3">Адрес и доставка</h3>
        <div class="text-xs space-y-1.5">
          <p class="text-chassis-200 font-medium">{siteConfig.address.fullAddress}</p>
          <p class="text-chassis-400">Ориентир: напротив Паркентского базара, магазин «Радиодетали»</p>
          <p class="text-chassis-400 pt-1">{siteConfig.address.deliveryInfo}</p>
          <p class="text-chassis-300 font-mono pt-1">{siteConfig.workingHours.days}: {siteConfig.workingHours.hours}</p>
        </div>

        <div class="flex items-center gap-2 pt-2">
          <a
            href={siteConfig.socials.yandexMaps}
            target="_blank"
            rel="noopener noreferrer"
            class="px-2.5 py-1 rounded border border-chassis-800 bg-chassis-850 hover:bg-chassis-800 text-chassis-300 hover:text-chassis-100 text-xs font-mono transition-colors"
          >
            Яндекс Карты
          </a>
          <a
            href={siteConfig.socials.googleMaps}
            target="_blank"
            rel="noopener noreferrer"
            class="px-2.5 py-1 rounded border border-chassis-800 bg-chassis-850 hover:bg-chassis-800 text-chassis-300 hover:text-chassis-100 text-xs font-mono transition-colors"
          >
            Google Maps
          </a>
        </div>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="mt-8 pt-6 border-t border-chassis-850 flex flex-col sm:flex-row items-center justify-between gap-2 text-xs text-chassis-400 font-mono">
      <p>© {currentYear} {siteConfig.legalName}. Все права защищены.</p>
      <p>{siteConfig.domain} (301-редирект с {siteConfig.redirectDomain})</p>
    </div>
  </div>
</footer>