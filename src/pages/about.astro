---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import IconLink from "@/components/IconLink.astro";
import { siteConfig } from "@/data/siteConfig";

const breadcrumbs = [
  { name: "О сервисе", url: "/about" },
];
---

<BaseLayout
  title="О сервисном центре Laptop Service в Ташкенте"
  description="Сервисный центр на ул. Паркент 11: микроскопы, BGA-пайка, осциллографы, компонентный ремонт плат с 2004 года."
  breadcrumbs={breadcrumbs}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 space-y-10">
    
    <Breadcrumbs items={breadcrumbs} />

    <header class="space-y-4">
      <div class="text-xs font-sans text-chassis-400 uppercase tracking-wider">
        Мастерская на ул. Паркент 11
      </div>

      <h1 class="text-2xl sm:text-4xl font-extrabold text-chassis-100 tracking-tight leading-tight">
        Сервисный центр Laptop Service
      </h1>

      <p class="text-xs sm:text-sm text-chassis-300 leading-relaxed">
        С 2004 года занимаемся компонентным ремонтом вычислительной техники и сложной радиоэлектроники в Ташкенте. Опыт позволяет восстанавливать платы на уровне отдельных микросхем, дорожек и радиодеталей — без навязывания замены всей платы.
      </p>
    </header>

    <!-- Workshop Equipment -->
    <section class="space-y-4">
      <h2 class="text-sm font-bold text-chassis-200 uppercase font-sans tracking-wider">
        Техническое оснащение
      </h2>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 text-xs font-sans">
        <div class="space-y-1">
          <div class="text-chassis-100 font-bold">Инфракрасная BGA станция</div>
          <div class="text-chassis-400 leading-relaxed">Бессвинцовая и свинцовая пайка GPU, комбайнов и хабов PCH без деформации текстолита.</div>
        </div>

        <div class="space-y-1">
          <div class="text-chassis-100 font-bold">Оптический стереомикроскоп</div>
          <div class="text-chassis-400 leading-relaxed">Восстановление проводников 0.02мм и пайка SMD-компонентов.</div>
        </div>

        <div class="space-y-1">
          <div class="text-chassis-100 font-bold">Диагностический комплекс</div>
          <div class="text-chassis-400 leading-relaxed">Осциллограф, тепловизор, ЛБП, программаторы RT809H и Vertyanov JIG.</div>
        </div>
      </div>
    </section>

    <!-- Principles -->
    <section class="space-y-4">
      <h2 class="text-sm font-bold text-chassis-200 uppercase font-sans tracking-wider">
        Принципы работы
      </h2>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs text-chassis-300">
        <div class="space-y-1">
          <div class="font-bold text-chassis-100 font-sans">1. Согласование цены до ремонта</div>
          <p class="text-chassis-400">Стоимость озвучивается после диагностики и согласуется строго до начала пайки.</p>
        </div>

        <div class="space-y-1">
          <div class="font-bold text-chassis-100 font-sans">2. Качественные расходники</div>
          <p class="text-chassis-400">Применяем фазовый термоинтерфейс Honeywell PTM7950 и безотмывочные флюсы.</p>
        </div>

        <div class="space-y-1">
          <div class="font-bold text-chassis-100 font-sans">3. Проверка под нагрузкой</div>
          <p class="text-chassis-400">Каждая плата после ремонта проходит обязательный стресс-тест в тестах стабильности.</p>
        </div>

        <div class="space-y-1">
          <div class="font-bold text-chassis-100 font-sans">4. Гарантия на работы</div>
          <p class="text-chassis-400">Мы даём гарантию на выполнение ваших работ — на пайку, чистку и установку. Если что-то не так — переделаем.</p>
        </div>

        <div class="space-y-1">
          <div class="font-bold text-chassis-100 font-sans">5. Быстрота без потери качества</div>
          <p class="text-chassis-400">Мы быстро исправим вашу поломку, но при этом всё будет качественно — без спешки в ущерб надёжности.</p>
        </div>

        <div class="space-y-1">
          <div class="font-bold text-chassis-100 font-sans">6. Гарантия качества</div>
          <p class="text-chassis-400">Работаем с 2004 года и отвечаем за результат. Реальные сроки, реальные гарантии, всегда на связи.</p>
        </div>
      </div>
    </section>

    <!-- Direct CTA -->
    <div class="rounded-lg border border-chassis-700 bg-chassis-950 p-6 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="text-xs text-chassis-300 text-center sm:text-left space-y-1">
        <div class="font-bold text-chassis-100">Нужна консультация?</div>
        <div>Напишите в Telegram или позвоните по прямому номеру.</div>
      </div>

      <div class="flex items-center gap-2 flex-wrap justify-center sm:justify-end">
        <IconLink
          type="threads"
          href={siteConfig.socials.threads}
          label="Threads"
          ariaLabel="Threads @laptopservice_uz"
          variant="button"
          target="_blank"
        />
        <IconLink
          type="telegram"
          href={siteConfig.telegram.masterUrl}
          label={`Telegram: ${siteConfig.telegram.masterHandle}`}
          ariaLabel="Написать в Telegram"
          variant="button"
          target="_blank"
          class="border-chassis-600 bg-chassis-800 hover:bg-chassis-700 text-chassis-100 font-bold"
        />
        <IconLink
          type="phone"
          href={`tel:${siteConfig.phones.primary}`}
          label={siteConfig.phones.displayPrimary}
          ariaLabel="Позвонить"
          variant="button"
          class="border-chassis-700 bg-chassis-900 hover:bg-chassis-800 text-chassis-200"
        />
      </div>
    </div>

  </div>
</BaseLayout>