---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import IconLink from "@/components/IconLink.astro";
import { siteConfig } from "@/data/siteConfig";

const breadcrumbs = [
  { name: "Контакты", url: "/contacts" },
];
---

<BaseLayout
  title="Контакты и схема проезда — Laptop Service Ташкент"
  description="Адрес сервисного центра Laptop Service: г. Ташкент, ул. Паркент 11 (напротив Паркентского базара, магазин «Радиодетали»). Телефоны, Telegram, доставка."
  type="LocalBusiness"
  breadcrumbs={breadcrumbs}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 space-y-8">
    
    <Breadcrumbs items={breadcrumbs} />

    <header class="space-y-3">
      <div class="text-xs font-sans text-chassis-400 uppercase tracking-wider">
        Контакты сервисного центра
      </div>

      <h1 class="text-2xl sm:text-4xl font-extrabold text-chassis-100 tracking-tight leading-tight">
        Контакты, адрес и способы доставки
      </h1>

      <p class="text-xs sm:text-sm text-chassis-300 leading-relaxed">
        Сервисный центр находится на улице Паркент, дом 11. Напротив расположен Паркентский базар, магазин «Радиодетали».
      </p>
    </header>

    <!-- Адрес и навигация — над адресом и режимом -->
    <section class="space-y-4">
      <h3 class="text-sm font-bold text-chassis-100 font-sans uppercase tracking-wider">Адрес и навигация</h3>
      <p class="text-xs text-chassis-300">{siteConfig.address.fullAddress} — напротив Паркентского базара, магазин «Радиодетали».</p>
      <p class="text-xs text-chassis-400">Координаты: {siteConfig.address.geo.latitude}° N, {siteConfig.address.geo.longitude}° E</p>
      <div class="flex flex-wrap gap-2">
        <IconLink
          type="yandex-maps"
          href={siteConfig.socials.yandexMaps}
          label="Яндекс Карты"
          ariaLabel="Открыть в Яндекс Картах"
          variant="button"
          target="_blank"
          class="border-chassis-700 bg-chassis-800 hover:bg-chassis-700 text-chassis-100"
        />
        <IconLink
          type="google-maps"
          href={siteConfig.socials.googleMaps}
          label="Google Maps"
          ariaLabel="Открыть в Google Maps"
          variant="button"
          target="_blank"
          class="border-chassis-700 bg-chassis-800 hover:bg-chassis-700 text-chassis-100"
        />
      </div>
    </section>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 text-xs">
      
      <!-- Телефоны -->
      <div class="space-y-4">
        <div class="text-chassis-400 uppercase tracking-wider font-sans font-bold text-[11px]">Контакты</div>
        <div class="space-y-3">
          <div class="space-y-1">
            <span class="text-chassis-400 block text-[11px]">Телефон для звонков:</span>
            <IconLink
              type="phone"
              href={`tel:${siteConfig.phones.primary}`}
              label={siteConfig.phones.displayPrimary}
              ariaLabel="Позвонить"
              variant="inline"
              class="text-sm font-bold text-chassis-100"
            />
          </div>
          <div class="space-y-1">
            <span class="text-chassis-400 block text-[11px]">Telegram:</span>
            <IconLink
              type="telegram"
              href={siteConfig.telegram.masterUrl}
              label={siteConfig.telegram.masterHandle}
              ariaLabel="Написать в Telegram"
              variant="inline"
              target="_blank"
              class="text-sm font-bold text-chassis-200"
            />
          </div>
        </div>
      </div>

      <!-- Режим работы -->
      <div class="space-y-4">
        <div class="text-chassis-400 uppercase tracking-wider font-sans font-bold text-[11px]">Режим работы</div>
        <div class="space-y-2 font-sans">
          <div>
            <span class="text-chassis-400 block text-[11px]">График:</span>
            <span class="text-chassis-200">{siteConfig.workingHours.days}: {siteConfig.workingHours.hours}</span>
          </div>
          <div>
            <span class="text-chassis-400 block text-[11px]">Воскресенье:</span>
            <span class="text-chassis-300">{siteConfig.workingHours.sunday}</span>
          </div>
          <div>
            <span class="text-chassis-400 block text-[11px]">Адрес:</span>
            <span class="text-chassis-100 block">{siteConfig.address.fullAddress}</span>
          </div>
        </div>
      </div>

    </div>

    <!-- Руководитель сервиса -->
    <section class="rounded border border-chassis-700 bg-chassis-900 p-6 space-y-3">
      <h3 class="text-sm font-bold text-chassis-100 font-sans uppercase tracking-wider">Руководитель сервиса</h3>
      <div class="flex flex-col sm:flex-row sm:items-center gap-2">
        <span class="text-sm font-bold text-chassis-100">{siteConfig.manager.name}</span>
        <span class="text-xs text-chassis-400">— писать и звонить строго по делу</span>
      </div>
      <div class="flex flex-wrap gap-2">
        <IconLink
          type="phone"
          href={`tel:${siteConfig.manager.phone}`}
          label={siteConfig.manager.displayPhone}
          ariaLabel="Позвонить руководителю"
          variant="button"
          class="border-chassis-600 bg-chassis-800 hover:bg-chassis-700 text-chassis-100 font-bold"
        />
        <IconLink
          type="telegram"
          href={siteConfig.manager.telegramUrl}
          label={siteConfig.manager.telegram}
          ariaLabel="Telegram руководителя"
          variant="button"
          target="_blank"
          class="border-chassis-700 bg-chassis-800 hover:bg-chassis-700 text-chassis-100"
        />
      </div>
    </section>

    <!-- Бесплатная диагностика -->
    <section class="space-y-3 text-xs text-chassis-300">
      <h3 class="text-sm font-bold text-chassis-100 font-sans uppercase tracking-wider">Бесплатная диагностика</h3>
      <p class="leading-relaxed">
        Привезите ноутбук лично в сервисный центр на ул. Паркент 11. Зачастую проблема неочевидна с первого взгляда — в таких случаях оставляете устройство, мы фиксируем акт приёма и ваши контакты, и проводим диагностику. Это занимает время.
      </p>
      <p class="leading-relaxed text-chassis-400">
        Когда причина найдена, мы звоним по оставленному контакту, объясняем неисправность и согласуем стоимость. Только после вашего согласия мастер приступает к ремонту.
      </p>
    </section>

  </div>
</BaseLayout>