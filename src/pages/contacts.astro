---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import IconLink from "@/components/IconLink.astro";
import { siteConfig } from "@/data/siteConfig";

const breadcrumbs = [
  { name: "Контакты", url: "/contacts" },
];
---

<BaseLayout
  title="Контакты и схема проезда — Laptop Service Ташкент"
  description="Адрес сервисного центра Laptop Service: г. Ташкент, ул. Паркент 11 (напротив Паркентского базара, магазин «Радиодетали»). Телефоны, Telegram, доставка."
  type="LocalBusiness"
  breadcrumbs={breadcrumbs}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 space-y-8">
    
    <Breadcrumbs items={breadcrumbs} />

    <header class="space-y-3">
      <div class="text-xs font-sans text-chassis-400 uppercase tracking-wider">
        Контакты сервисного центра
      </div>

      <h1 class="text-2xl sm:text-4xl font-extrabold text-chassis-100 tracking-tight leading-tight">
        Контакты, адрес и способы доставки
      </h1>

      <p class="text-xs sm:text-sm text-chassis-300 leading-relaxed">
        Сервисный центр находится на улице Паркент, дом 11. Напротив расположен Паркентский базар, магазин «Радиодетали».
      </p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 text-xs">
      
      <!-- Phone & Telegram -->
      <div class="space-y-4">
        <div class="text-chassis-400 uppercase tracking-wider font-sans font-bold text-[11px]">Контакты</div>
        <div class="space-y-3">
          <div class="space-y-1">
            <span class="text-chassis-400 block text-[11px]">Телефон для звонков:</span>
            <IconLink
              type="phone"
              href={`tel:${siteConfig.phones.primary}`}
              label={siteConfig.phones.displayPrimary}
              ariaLabel="Позвонить"
              variant="inline"
              class="text-sm font-bold text-chassis-100"
            />
          </div>
          <div class="space-y-1">
            <span class="text-chassis-400 block text-[11px]">Telegram:</span>
            <IconLink
              type="telegram"
              href={siteConfig.telegram.masterUrl}
              label={siteConfig.telegram.masterHandle}
              ariaLabel="Написать в Telegram"
              variant="inline"
              target="_blank"
              class="text-sm font-bold text-chassis-200"
            />
          </div>
          <div class="space-y-1">
            <span class="text-chassis-400 block text-[11px]">Telegram канал:</span>
            <IconLink
              type="telegram-channel"
              href={siteConfig.telegram.channelUrl}
              label={siteConfig.telegram.channel}
              ariaLabel="Telegram-канал @laptopservice_uz"
              variant="inline"
              target="_blank"
              class="text-chassis-300"
            />
          </div>
          <div class="space-y-1">
            <span class="text-chassis-400 block text-[11px]">Telegram чат:</span>
            <IconLink
              type="telegram"
              href={siteConfig.telegram.chatUrl}
              label="t.me/laptop_service_chat"
              ariaLabel="Telegram-чат мастеров"
              variant="inline"
              target="_blank"
              class="text-chassis-300"
            />
          </div>
          <div class="flex gap-3 pt-1">
            <IconLink
              type="instagram"
              href={siteConfig.socials.instagram}
              label="Instagram"
              ariaLabel="Instagram: laptopservice_uz"
              variant="inline"
              target="_blank"
              class="text-chassis-300"
            />
            <IconLink
              type="facebook"
              href={siteConfig.socials.facebook}
              label="Facebook"
              ariaLabel="Facebook: RemontNoutbukov.uz"
              variant="inline"
              target="_blank"
              class="text-chassis-300"
            />
          </div>
        </div>
      </div>

      <!-- Address & Schedule -->
      <div class="space-y-4">
        <div class="text-chassis-400 uppercase tracking-wider font-sans font-bold text-[11px]">Адрес и режим работы</div>
        <div class="space-y-2 font-sans">
          <div>
            <span class="text-chassis-400 block text-[11px]">Физический адрес:</span>
            <span class="text-chassis-100 font-bold block">{siteConfig.address.fullAddress}</span>
          </div>
          <div>
            <span class="text-chassis-400 block text-[11px]">График работы:</span>
            <span class="text-chassis-200">{siteConfig.workingHours.days}: {siteConfig.workingHours.hours}</span>
          </div>
          <div>
            <span class="text-chassis-400 block text-[11px]">Воскресенье:</span>
            <span class="text-chassis-300">{siteConfig.workingHours.sunday}</span>
          </div>
        </div>
      </div>

    </div>

    <!-- Руководитель сервиса -->
    <section class="rounded border border-chassis-700 bg-chassis-900 p-6 space-y-3">
      <h3 class="text-sm font-bold text-chassis-100 font-sans uppercase tracking-wider">Руководитель сервиса</h3>
      <div class="flex flex-col sm:flex-row sm:items-center gap-2">
        <span class="text-sm font-bold text-chassis-100">{siteConfig.manager.name}</span>
        <span class="text-xs text-chassis-400">— писать и звонить строго по делу</span>
      </div>
      <div class="flex flex-wrap gap-2">
        <IconLink
          type="phone"
          href={`tel:${siteConfig.manager.phone}`}
          label={siteConfig.manager.displayPhone}
          ariaLabel="Позвонить руководителю"
          variant="button"
          class="border-chassis-600 bg-chassis-800 hover:bg-chassis-700 text-chassis-100 font-bold"
        />
        <IconLink
          type="telegram"
          href={siteConfig.manager.telegramUrl}
          label={siteConfig.manager.telegram}
          ariaLabel="Telegram руководителя"
          variant="button"
          target="_blank"
          class="border-chassis-700 bg-chassis-800 hover:bg-chassis-700 text-chassis-100"
        />
      </div>
    </section>

    <!-- Delivery Instructions -->
    <section class="space-y-3 text-xs text-chassis-300">
      <h3 class="text-sm font-bold text-chassis-100 font-sans uppercase tracking-wider">
        Доставка техники курьером / Яндекс Доставкой
      </h3>
      <p class="leading-relaxed">
        Если у вас нет возможности приехать лично, вы можете отправить ноутбук курьерской службой (Яндекс Доставка, Express) в рабочие часы сервисного центра.
      </p>
      <p class="leading-relaxed text-chassis-400">
        Перед отправкой обязательно напишите или позвоните мастеру, чтобы подтвердить отправку и указать модель устройства и симптомы поломки.
      </p>
    </section>

    <!-- Maps Links -->
    <section class="space-y-4">
      <h3 class="text-sm font-bold text-chassis-100 font-sans uppercase tracking-wider">
        Карты и навигация
      </h3>
      <p class="text-xs text-chassis-400">
        Координаты: 41.3144° N, 69.3148° E (г. Ташкент, ул. Паркент 11)
      </p>
      <div class="flex flex-wrap gap-2 pt-1">
        <IconLink
          type="yandex-maps"
          href={siteConfig.socials.yandexMaps}
          label="Яндекс Карты (laptop_service) →"
          ariaLabel="Открыть в Яндекс Картах"
          variant="button"
          target="_blank"
          class="border-chassis-700 bg-chassis-800 hover:bg-chassis-700 text-chassis-100"
        />
        <IconLink
          type="google-maps"
          href={siteConfig.socials.googleMaps}
          label="Google Maps →"
          ariaLabel="Открыть в Google Maps"
          variant="button"
          target="_blank"
          class="border-chassis-700 bg-chassis-800 hover:bg-chassis-700 text-chassis-100"
        />
      </div>
    </section>

  </div>
</BaseLayout>