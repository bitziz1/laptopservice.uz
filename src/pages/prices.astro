---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import PriceTable from "@/components/PriceTable.astro";

const breadcrumbs = [
  { name: "Диагностика и цены", url: "/prices" },
];
---

<BaseLayout
  title="Диагностика и порядок определения цен на ремонт ноутбуков — Laptop Service"
  description="Порядок ценообразования сервисного центра Laptop Service на ул. Паркент 11. Точная стоимость согласуется с клиентом строго до начала ремонта."
  breadcrumbs={breadcrumbs}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 space-y-8">
    
    <Breadcrumbs items={breadcrumbs} />

    <header class="space-y-3">
      <div class="text-xs font-sans text-chassis-400 uppercase tracking-wider">
        Прозрачный порядок работы
      </div>

      <h1 class="text-2xl sm:text-4xl font-extrabold text-chassis-100 tracking-tight leading-tight">
        Диагностика и порядок определения стоимости
      </h1>

      <p class="text-xs sm:text-sm text-chassis-300 leading-relaxed">
        Каждый ремонт индивидуален: одинаковые симптомы (например, «не включается») могут быть вызваны как простым пробоем копеечного конденсатора, так и выходом из строя мультиконтроллера или комбайна. Настоящая актуальная стоимость определяется только после физической диагностики платы.
      </p>
    </header>

    <PriceTable />

    <!-- Details Policy -->
    <section class="space-y-3 text-xs text-chassis-300">
      <h3 class="text-sm font-bold text-chassis-100 font-sans uppercase tracking-wider">
        Стоимость запасных частей и комплектующих
      </h3>
      <p class="leading-relaxed">
        Цены на новые оригинальные BGA-чипы (видеокарты, хабы, процессоры) и матрицы зависят от модели ноутбука и регулярно меняются у поставщиков. Мастер проверяет наличие и озвучивает актуальную стоимость запчастей в момент диагностики.
      </p>
      <p class="leading-relaxed text-chassis-400">
        Также, если у вас уже есть совместимые комплектующие (SSD, оперативная память, дисплей) и вы уверены в выборе, можем установить их — тогда оплачивается только работа. Подскажем и другие варианты, чтобы вы приняли взвешенное решение. Наша миссия — помочь решить проблему с вашим ноутбуком: ежедневно мастера с большим опытом занимаются своим делом и верят в то, что делают.
      </p>
    </section>

    <!-- Direct CTA — сильный призыв -->
    <div class="rounded-lg border border-chassis-700 bg-chassis-950 p-6 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="text-xs text-chassis-300 text-center sm:text-left space-y-1">
        <div class="font-bold text-chassis-100 text-sm">Хотите решить свою проблему?</div>
        <div>Оставьте контакты — подскажем, что делать дальше и сориентируем по срокам.</div>
      </div>
      <a href="/contacts" class="px-6 py-3 rounded-lg border border-chassis-600 bg-chassis-800 hover:bg-chassis-700 text-chassis-100 text-sm font-bold transition-colors shrink-0">
        Перейти в контакты →
      </a>
    </div>

  </div>
</BaseLayout>