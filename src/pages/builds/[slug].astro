---
import { Picture } from "astro:assets";
import { getCollection, render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import IconLink from "@/components/IconLink.astro";
import VisualBuild from "@/components/VisualBuild";
import { siteConfig } from "@/data/siteConfig";

// Tina Visual Editing: try to fetch via Tina GraphQL when dev server running, fallback to astro:content for production (gh-pages)
import client from "../../../tina/__generated__/client";

const BUILD_QUERY = `query($relativePath:String!){ builds(relativePath:$relativePath){ title purpose purposeLabel date description components{ cpu motherboard ram gpu storage psu case cooler } complexity tags heroImage gallery body } }`;

export async function getStaticPaths() {
  const entries = await getCollection("builds");
  return entries.map((entry) => {
    const slug = entry.id.replace(/\.md$/, "");
    return {
      params: { slug },
      props: { entry, slug },
    };
  });
}

const { entry, slug } = Astro.props as { entry: any; slug: string };

// Try Tina query – succeeds only when `tinacms dev` GraphQL on 4001 is running; on prod (gh-pages build) it fails fast and falls back to astro:content
let tinaData: any = null;
let tinaError: string | null = null;
const tinaVariables = { relativePath: `${slug}.md` };
let tinaPayload: any = null;
try {
  const gqlRes = await fetch("http://localhost:4001/graphql", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ query: BUILD_QUERY, variables: tinaVariables }),
  });
  if (gqlRes.ok) {
    const json: any = await gqlRes.json();
    if (json?.data?.builds) {
      tinaData = json.data.builds;
      tinaPayload = { query: BUILD_QUERY, variables: tinaVariables, data: json.data };
    } else tinaError = json?.errors?.[0]?.message ?? "no data";
  } else tinaError = `http ${gqlRes.status}`;
} catch (e: any) {
  tinaError = e?.message ?? String(e);
  try {
    const res = await client.queries.builds({ relativePath: `${slug}.md` });
    tinaData = res?.data?.builds ?? null;
    if (tinaData) {
      tinaPayload = { query: res.query, variables: res.variables, data: res.data };
      tinaError = null;
    }
  } catch {}
}

const isTina = !!tinaData;
const raw = isTina ? tinaData : entry.data;
const build = {
  ...raw,
  slug,
  // Tina returns date as ISO string, astro returns Date
  date: raw.date instanceof Date ? raw.date.toISOString().slice(0, 10) : String(raw.date).slice(0, 10),
  // Normalize components/tags for Tina (may have null)
  components: raw.components ?? {},
  tags: raw.tags ?? [],
};

const breadcrumbs = [
  { name: "Сборки ПК", url: "/builds" },
  { name: build.title, url: `/builds/${slug}` },
];

const componentLabels: Record<string, string> = {
  cpu: "Процессор",
  motherboard: "Материнская плата",
  ram: "Оперативная память",
  gpu: "Видеокарта",
  storage: "Накопители",
  psu: "Блок питания",
  case: "Корпус",
  cooler: "Охлаждение",
};

const componentEntries = Object.entries(build.components ?? {}) as [string, string][];

const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  headline: build.title,
  description: build.description,
  image: `${siteConfig.url}/og/${slug}.png`,
  author: { "@type": "Organization", name: siteConfig.brandName, url: siteConfig.url },
  publisher: { "@type": "Organization", name: siteConfig.brandName, logo: { "@type": "ImageObject", url: `${siteConfig.url}/favicon.svg` } },
  datePublished: build.date,
  dateModified: build.date,
  mainEntityOfPage: { "@type": "WebPage", "@id": `${siteConfig.url}/builds/${slug}` },
  keywords: build.tags.join(", "),
  articleSection: build.purposeLabel,
};

const galleryImages: any[] = (() => {
  const g = entry.data.gallery ?? [];
  const h = entry.data.heroImage ?? null;
  return h ? [h, ...g] : g;
})();
const { Content } = await render(entry);
---

<BaseLayout
  title={`${build.title} — Сборка ПК в Ташкенте`}
  description={`${build.description.slice(0, 150)} Сервисный центр на Паркент 11, подбор комплектующих и гарантия.`}
  breadcrumbs={breadcrumbs}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 space-y-8">
    <Breadcrumbs items={breadcrumbs} />

    {isTina && tinaPayload ? (
      <VisualBuild client:load query={tinaPayload.query} variables={tinaPayload.variables} data={tinaPayload.data} />
    ) : (
      <>
        <header class="space-y-4">
          <div class="flex flex-wrap items-center gap-2 text-xs">
            <span class="text-chassis-400 font-bold uppercase tracking-wider">{build.purposeLabel}</span>
            <span class="text-chassis-400">• {build.date}</span>
            {import.meta.env.DEV && <span class="text-chassis-500 text-[10px]">{tinaError ? `Tina err: ${tinaError}` : "Tina offline"}</span>}
          </div>
          <h1 class="text-2xl sm:text-4xl font-extrabold text-chassis-100 tracking-tight leading-tight">{build.title}</h1>
          <p class="text-sm sm:text-base text-chassis-300 leading-relaxed">{build.description}</p>
        </header>

        {galleryImages.length === 1 ? (
          <div class="rounded-lg overflow-hidden border border-chassis-800 bg-chassis-900 cursor-zoom-in" data-build-gallery data-build-img>
            <Picture src={galleryImages[0]} alt={build.title} widths={[400, 800, 1200]} sizes="(max-width: 768px) 100vw, 800px" formats={["avif", "webp"]} fallbackFormat="webp" class="w-full h-auto object-contain cursor-zoom-in" loading="lazy" decoding="async" />
          </div>
        ) : galleryImages.length > 1 ? (
          <div class="relative" data-build-gallery-wrap>
            <button type="button" data-build-prev aria-label="Назад" class="hidden md:flex absolute left-1 lg:-left-4 top-1/2 -translate-y-1/2 z-10 w-9 h-9 items-center justify-center rounded-full bg-black/70 backdrop-blur-md border border-white/15 text-white hover:bg-black/85 transition shadow-lg disabled:opacity-30 disabled:pointer-events-none">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
            </button>
            <button type="button" data-build-next aria-label="Вперед" class="hidden md:flex absolute right-1 lg:-right-4 top-1/2 -translate-y-1/2 z-10 w-9 h-9 items-center justify-center rounded-full bg-black/70 backdrop-blur-md border border-white/15 text-white hover:bg-black/85 transition shadow-lg disabled:opacity-30 disabled:pointer-events-none">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
            </button>
            <div class="build-gallery-scroller flex gap-3 overflow-x-auto overflow-y-hidden pb-2 snap-x snap-mandatory scroll-smooth -mx-4 px-4 sm:mx-0 sm:px-0" data-build-gallery>
              {galleryImages.map((img: any) => (
                <div class="shrink-0 snap-start w-[88vw] sm:w-[520px] rounded-lg overflow-hidden border border-chassis-800 bg-chassis-900 cursor-zoom-in" data-build-img>
                  <Picture src={img} alt={build.title} widths={[400, 600, 800]} sizes="(max-width: 640px) 88vw, 520px" formats={["avif", "webp"]} fallbackFormat="webp" class="w-full h-[240px] sm:h-[340px] object-contain sm:object-cover cursor-zoom-in" loading="lazy" decoding="async" />
                </div>
              ))}
            </div>
          </div>
        ) : null}

        {Content && (
          <article class="prose prose-invert max-w-none prose-sm sm:prose-base prose-headings:text-chassis-100 prose-p:text-chassis-300">
            <Content />
          </article>
        )}

        <section class="py-2 space-y-4">
          <h2 class="text-sm font-bold text-chassis-200 uppercase font-sans tracking-wider">Состав</h2>
          <div class="space-y-4 text-xs font-mono">
            {componentEntries.map(([key, value]) => (
              <div class="flex flex-col sm:flex-row sm:items-start gap-1 sm:gap-3">
                <span class="text-chassis-400 shrink-0 sm:w-40 font-sans font-bold uppercase text-[11px] tracking-wider">{componentLabels[key] ?? key}</span>
                <span class="text-chassis-200 leading-relaxed">{value}</span>
              </div>
            ))}
          </div>
          <p class="text-xs text-chassis-400 leading-relaxed">Комплектующие подбираются из наличия в Ташкенте с возможностью замены на аналог по согласованию.</p>
        </section>

        <div class="flex flex-wrap gap-2 pt-2">
          {build.tags.map((tag: string) => (
            <span class="text-[11px] font-sans text-sky-400">#{tag}</span>
          ))}
        </div>
      </>
    )}

    <!-- JSON-LD TechArticle — no Product snippet requirements (offers/review/aggregateRating) -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />

    {isTina && tinaPayload ? null : (
      <div class="flex flex-wrap gap-2 pt-2 hidden">{/* placeholder to keep layout */}</div>
    )}

    <!-- CTA -->
    <div class="rounded-lg border border-chassis-700 bg-chassis-950 p-6 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="text-xs text-chassis-300 text-center sm:text-left space-y-1">
        <div class="font-bold text-chassis-100">Заказать такую сборку или подобрать аналог?</div>
        <div>Опишите свою задачу и бюджет, мы предложим варианты.</div>
      </div>
      <div class="flex items-center gap-2">
        <IconLink
          type="telegram"
          href={siteConfig.telegram.masterUrl}
          label="Написать в Telegram"
          ariaLabel="Написать в Telegram"
          variant="button"
          target="_blank"
          class="border-chassis-600 bg-chassis-800 hover:bg-chassis-700 text-chassis-100 font-bold"
        />
        <IconLink
          type="phone"
          href={`tel:${siteConfig.phones.primary}`}
          label="Позвонить"
          ariaLabel="Позвонить"
          variant="button"
          class="border-chassis-700 bg-chassis-900 hover:bg-chassis-800 text-chassis-200"
        />
      </div>
    </div>

    <div class="flex justify-center">
      <a href="/builds" class="text-xs font-sans text-chassis-300 hover:text-chassis-100 underline">
        ← ко всем сборкам
      </a>
    </div>
  </div>

  <!-- Lightbox для галереи (мобилка и desktop) -->
  <div id="build-lightbox" class="hidden fixed inset-0 z-[100] bg-black/85 backdrop-blur-sm items-center justify-center p-4 cursor-zoom-out" aria-hidden="true">
    <img id="build-lightbox-img" src="" alt="" class="max-w-[95vw] max-h-[92vh] object-contain rounded-lg border border-white/10 shadow-2xl" />
    <button type="button" id="build-lightbox-close" aria-label="Закрыть" class="absolute top-4 right-4 w-9 h-9 rounded-full bg-black/60 border border-white/15 text-white flex items-center justify-center hover:bg-black/80 transition">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
    </button>
  </div>

  <style>
    .build-gallery-scroller { scrollbar-width:none; -ms-overflow-style:none; -webkit-overflow-scrolling:touch; }
    .build-gallery-scroller::-webkit-scrollbar { display:none; }
  </style>

  <script is:inline>
    (function(){
      var gallery = document.querySelector('[data-build-gallery]');
      var wrap = document.querySelector('[data-build-gallery-wrap]');
      var lightbox = document.getElementById('build-lightbox');
      var lightboxImg = document.getElementById('build-lightbox-img');
      var closeBtn = document.getElementById('build-lightbox-close');
      if(!lightbox || !lightboxImg) return;
      function open(src, alt){
        lightboxImg.src = src;
        lightboxImg.alt = alt || '';
        lightbox.classList.remove('hidden');
        lightbox.classList.add('flex');
        lightbox.setAttribute('aria-hidden','false');
        document.body.style.overflow = 'hidden';
      }
      function close(){
        lightbox.classList.add('hidden');
        lightbox.classList.remove('flex');
        lightbox.setAttribute('aria-hidden','true');
        document.body.style.overflow = '';
        lightboxImg.src = '';
      }
      document.addEventListener('click', function(e){
        var img = e.target.closest('[data-build-img]');
        if(img){
          // Picture component renders <img>; also wrapper div may be clicked
          var targetImg = img.tagName === 'IMG' ? img : img.querySelector('img');
          if(!targetImg) targetImg = img;
          var src = targetImg.currentSrc || targetImg.src;
          // try to get largest from srcset if available
          if(targetImg.srcset){
            var candidates = targetImg.srcset.split(',').map(function(s){ return s.trim().split(' ')[0]; });
            if(candidates.length) src = candidates[candidates.length-1];
          }
          open(src, targetImg.alt);
          e.preventDefault();
          return;
        }
        if(e.target.closest('#build-lightbox')){
          close();
        }
      });
      document.addEventListener('keydown', function(e){ if(e.key==='Escape' && !lightbox.classList.contains('hidden')) close(); });
      if(closeBtn) closeBtn.addEventListener('click', function(e){ e.stopPropagation(); close(); });

      // Desktop arrows for build gallery
      if(wrap){
        var scroller = wrap.querySelector('.build-gallery-scroller');
        var prev = wrap.querySelector('[data-build-prev]');
        var next = wrap.querySelector('[data-build-next]');
        if(scroller && prev && next){
          function update(){
            var need = scroller.scrollWidth > scroller.clientWidth + 8;
            var atStart = scroller.scrollLeft <= 4;
            var atEnd = scroller.scrollLeft + scroller.clientWidth >= scroller.scrollWidth - 4;
            prev.disabled = atStart;
            next.disabled = atEnd;
            if(!need){ prev.style.display='none'; next.style.display='none'; } else { prev.style.display=''; next.style.display=''; }
          }
          function by(dir){
            var card = scroller.querySelector('.shrink-0');
            var amount = card ? card.offsetWidth + 12 : scroller.clientWidth * 0.85;
            scroller.scrollBy({left: dir*amount, behavior:'smooth'});
          }
          prev.addEventListener('click', function(){ by(-1); });
          next.addEventListener('click', function(){ by(1); });
          scroller.addEventListener('scroll', update, {passive:true});
          window.addEventListener('resize', update);
          var ro = new ResizeObserver(update);
          ro.observe(scroller);
          setTimeout(update, 120);
          requestAnimationFrame(update);
        }
      }
    })();
  </script>
</BaseLayout>
