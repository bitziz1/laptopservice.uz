---
import { Picture } from "astro:assets";
import { getCollection, render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import IconLink from "@/components/IconLink.astro";
import VisualBuild from "@/components/VisualBuild";
import { siteConfig } from "@/data/siteConfig";

// Tina Visual Editing: try to fetch via Tina GraphQL when dev server running, fallback to astro:content for production (gh-pages)
import client from "../../../tina/__generated__/client";

const BUILD_QUERY = `query($relativePath:String!){ builds(relativePath:$relativePath){ title purpose purposeLabel date description components{ cpu motherboard ram gpu storage psu case cooler } complexity tags heroImage gallery body } }`;

export async function getStaticPaths() {
  const entries = await getCollection("builds");
  return entries.map((entry) => {
    const slug = entry.id.replace(/\.md$/, "");
    return {
      params: { slug },
      props: { entry, slug },
    };
  });
}

const { entry, slug } = Astro.props as { entry: any; slug: string };

// Try Tina query – succeeds only when `tinacms dev` GraphQL on 4001 is running; on prod (gh-pages build) it fails fast and falls back to astro:content
let tinaData: any = null;
let tinaError: string | null = null;
const tinaVariables = { relativePath: `${slug}.md` };
let tinaPayload: any = null;
try {
  const gqlRes = await fetch("http://localhost:4001/graphql", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ query: BUILD_QUERY, variables: tinaVariables }),
  });
  if (gqlRes.ok) {
    const json: any = await gqlRes.json();
    if (json?.data?.builds) {
      tinaData = json.data.builds;
      tinaPayload = { query: BUILD_QUERY, variables: tinaVariables, data: json.data };
    } else tinaError = json?.errors?.[0]?.message ?? "no data";
  } else tinaError = `http ${gqlRes.status}`;
} catch (e: any) {
  tinaError = e?.message ?? String(e);
  try {
    const res = await client.queries.builds({ relativePath: `${slug}.md` });
    tinaData = res?.data?.builds ?? null;
    if (tinaData) {
      tinaPayload = { query: res.query, variables: res.variables, data: res.data };
      tinaError = null;
    }
  } catch {}
}

const isTina = !!tinaData;
const raw = isTina ? tinaData : entry.data;
const build = {
  ...raw,
  slug,
  // Tina returns date as ISO string, astro returns Date
  date: raw.date instanceof Date ? raw.date.toISOString().slice(0, 10) : String(raw.date).slice(0, 10),
  // Normalize components/tags for Tina (may have null)
  components: raw.components ?? {},
  tags: raw.tags ?? [],
};

const breadcrumbs = [
  { name: "Сборки ПК", url: "/builds" },
  { name: build.title, url: `/builds/${slug}` },
];

const componentLabels: Record<string, string> = {
  cpu: "Процессор",
  motherboard: "Материнская плата",
  ram: "Оперативная память",
  gpu: "Видеокарта",
  storage: "Накопители",
  psu: "Блок питания",
  case: "Корпус",
  cooler: "Охлаждение",
};

const componentEntries = Object.entries(build.components ?? {}) as [string, string][];

const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  headline: build.title,
  description: build.description,
  image: `${siteConfig.url}/og/${slug}.png`,
  author: { "@type": "Organization", name: siteConfig.brandName, url: siteConfig.url },
  publisher: { "@type": "Organization", name: siteConfig.brandName, logo: { "@type": "ImageObject", url: `${siteConfig.url}/favicon.svg` } },
  datePublished: build.date,
  dateModified: build.date,
  mainEntityOfPage: { "@type": "WebPage", "@id": `${siteConfig.url}/builds/${slug}` },
  keywords: build.tags.join(", "),
  articleSection: build.purposeLabel,
};

const galleryImages: any[] = (() => {
  const g = entry.data.gallery ?? [];
  const h = entry.data.heroImage ?? null;
  return h ? [h, ...g] : g;
})();
const { Content } = await render(entry);
---

<BaseLayout
  title={`${build.title} — Сборка ПК в Ташкенте`}
  description={`${build.description.slice(0, 150)} Сервисный центр на Паркент 11, подбор комплектующих и гарантия.`}
  breadcrumbs={breadcrumbs}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 space-y-8">
    <Breadcrumbs items={breadcrumbs} />

    {isTina && tinaPayload ? (
      <VisualBuild client:load query={tinaPayload.query} variables={tinaPayload.variables} data={tinaPayload.data} />
    ) : (
      <>
        <header class="space-y-4">
          <div class="flex flex-wrap items-center gap-2 text-xs">
            <span class="text-chassis-400 font-bold uppercase tracking-wider">{build.purposeLabel}</span>
            <span class="text-chassis-400">• {build.date}</span>
            {import.meta.env.DEV && <span class="text-chassis-500 text-[10px]">{tinaError ? `Tina err: ${tinaError}` : "Tina offline"}</span>}
          </div>
          <h1 class="text-2xl sm:text-4xl font-extrabold text-chassis-100 tracking-tight leading-tight">{build.title}</h1>
          <p class="text-sm sm:text-base text-chassis-300 leading-relaxed">{build.description}</p>
        </header>

        {galleryImages.length > 0 && (
          <div class={galleryImages.length === 1 ? "rounded-lg overflow-hidden border border-chassis-800 bg-chassis-900" : "grid grid-cols-1 sm:grid-cols-2 gap-3"}>
            {galleryImages.map((img: any) => (
              <div class="rounded-lg overflow-hidden border border-chassis-800 bg-chassis-900">
                <Picture src={img} alt={build.title} widths={[400, 800]} sizes="(max-width: 768px) 100vw, 800px" formats={["avif", "webp"]} fallbackFormat="webp" class="w-full h-auto object-contain" loading="lazy" decoding="async" />
              </div>
            ))}
          </div>
        )}

        {Content && (
          <article class="prose prose-invert max-w-none prose-sm sm:prose-base prose-headings:text-chassis-100 prose-p:text-chassis-300">
            <Content />
          </article>
        )}

        <section class="py-2 space-y-4">
          <h2 class="text-sm font-bold text-chassis-200 uppercase font-sans tracking-wider">Состав</h2>
          <div class="space-y-4 text-xs font-mono">
            {componentEntries.map(([key, value]) => (
              <div class="flex flex-col sm:flex-row sm:items-start gap-1 sm:gap-3">
                <span class="text-chassis-400 shrink-0 sm:w-40 font-sans font-bold uppercase text-[11px] tracking-wider">{componentLabels[key] ?? key}</span>
                <span class="text-chassis-200 leading-relaxed">{value}</span>
              </div>
            ))}
          </div>
          <p class="text-xs text-chassis-400 leading-relaxed">Комплектующие подбираются из наличия в Ташкенте с возможностью замены на аналог по согласованию.</p>
        </section>

        <div class="flex flex-wrap gap-2 pt-2">
          {build.tags.map((tag: string) => (
            <span class="text-[11px] font-sans text-sky-400">#{tag}</span>
          ))}
        </div>
      </>
    )}

    <!-- JSON-LD TechArticle — no Product snippet requirements (offers/review/aggregateRating) -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />

    {isTina && tinaPayload ? null : (
      <div class="flex flex-wrap gap-2 pt-2 hidden">{/* placeholder to keep layout */}</div>
    )}

    <!-- CTA -->
    <div class="rounded-lg border border-chassis-700 bg-chassis-950 p-6 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="text-xs text-chassis-300 text-center sm:text-left space-y-1">
        <div class="font-bold text-chassis-100">Заказать такую сборку или подобрать аналог?</div>
        <div>Опишите свою задачу и бюджет, мы предложим варианты.</div>
      </div>
      <div class="flex items-center gap-2">
        <IconLink
          type="telegram"
          href={siteConfig.telegram.masterUrl}
          label="Написать в Telegram"
          ariaLabel="Написать в Telegram"
          variant="button"
          target="_blank"
          class="border-chassis-600 bg-chassis-800 hover:bg-chassis-700 text-chassis-100 font-bold"
        />
        <IconLink
          type="phone"
          href={`tel:${siteConfig.phones.primary}`}
          label="Позвонить"
          ariaLabel="Позвонить"
          variant="button"
          class="border-chassis-700 bg-chassis-900 hover:bg-chassis-800 text-chassis-200"
        />
      </div>
    </div>

    <div class="flex justify-center">
      <a href="/builds" class="text-xs font-sans text-chassis-300 hover:text-chassis-100 underline">
        ← ко всем сборкам
      </a>
    </div>
  </div>
</BaseLayout>
