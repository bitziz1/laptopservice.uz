---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import BuildCard from "@/components/BuildCard.astro";
import IconLink from "@/components/IconLink.astro";
import { buildsData } from "@/data/builds";
import { siteConfig } from "@/data/siteConfig";

const breadcrumbs = [
  { name: "Сборки ПК", url: "/builds" },
];

// For client-side filtering, we expose purpose values
const purposes = [
  { value: "all", label: "Все сборки" },
  { value: "gaming", label: "Игры" },
  { value: "ai-work", label: "AI / Нейросети" },
  { value: "office", label: "Офис" },
  { value: "rendering", label: "Рендер" },
];
---

<BaseLayout
  title="Сборка ПК под задачу в Ташкенте — игровые, офисные, AI-станции"
  description="Собираем ПК под вашу задачу: игры, AI/нейросети, монтаж и офис. Подбор комплектующих, совместимость и сборка с гарантией. Сервисный центр на ул. Паркент 11, Ташкент. Согласование цены до сборки."
  breadcrumbs={breadcrumbs}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 space-y-8">
    <Breadcrumbs items={breadcrumbs} />

    <div class="max-w-3xl space-y-3">
      <div class="text-xs font-sans text-chassis-400 uppercase tracking-wider">Сборки ПК • Паркент 11</div>
      <h1 class="text-2xl sm:text-4xl font-extrabold text-chassis-100 tracking-tight">
        Сборка ПК под задачу
      </h1>
      <p class="text-xs sm:text-sm text-chassis-300 leading-relaxed">
        Подбираем комплектующие под ваш бюджет и задачу — от тихого офисного ПК до игровой и AI-станции на RTX 4090. Проверяем совместимость, собираем, тестируем и даём гарантию. Цена озвучивается и согласуется до закупки.
      </p>
    </div>

    <div class="p-4 rounded border border-chassis-700 bg-chassis-850 text-xs font-sans text-chassis-300">
      <strong class="text-chassis-100">Как заказать:</strong> напишите мастеру модель задач (игры, монтаж, нейросети, офис) и бюджет — мы пришлём 2–3 варианта сборки на выбор.
    </div>

    <!-- Filters -->
    <div class="flex flex-wrap gap-2" id="build-filters">
      {purposes.map((p) => (
        <button
          type="button"
          data-purpose={p.value}
          class={`filter-btn px-3 py-1.5 rounded border text-xs font-sans font-bold uppercase tracking-wider transition-colors ${p.value === "all" ? "bg-chassis-800 border-chassis-600 text-chassis-100" : "bg-chassis-900 border-chassis-800 text-chassis-400 hover:text-chassis-200"}`}
        >
          {p.label}
        </button>
      ))}
    </div>

    <!-- Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5" id="builds-grid">
      {buildsData.map((build) => (
        <div data-purpose={build.purpose} class="build-card">
          <BuildCard build={build} />
        </div>
      ))}
    </div>

    {buildsData.length === 0 && (
      <div class="rounded border border-chassis-800 bg-chassis-850 p-6 text-xs text-chassis-400 text-center">
        Пока нет опубликованных сборок. Следите за обновлениями в Telegram-канале.
      </div>
    )}

    <!-- CTA -->
    <div class="rounded-lg border border-chassis-700 bg-chassis-950 p-6 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="text-xs text-chassis-300 text-center sm:text-left space-y-1">
        <div class="font-bold text-chassis-100">Нужна сборка под ваш бюджет?</div>
        <div>Напишите задачу и желаемую сумму — мастер предложит варианты комплектующих.</div>
      </div>
      <div class="flex items-center gap-2">
        <IconLink
          type="telegram"
          href={siteConfig.telegram.masterUrl}
          label="Telegram мастера"
          ariaLabel="Написать мастеру в Telegram"
          variant="button"
          target="_blank"
          class="border-chassis-600 bg-chassis-800 hover:bg-chassis-700 text-chassis-100 font-bold"
        />
        <IconLink
          type="phone"
          href={`tel:${siteConfig.phones.primary}`}
          label="Позвонить"
          ariaLabel="Позвонить мастеру"
          variant="button"
          class="border-chassis-700 bg-chassis-900 hover:bg-chassis-800 text-chassis-200"
        />
      </div>
    </div>
  </div>
</BaseLayout>

<script is:inline>
  const buttons = document.querySelectorAll('.filter-btn');
  const cards = document.querySelectorAll('.build-card');
  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const purpose = btn.getAttribute('data-purpose');
      buttons.forEach((b) => {
        b.classList.remove('bg-chassis-800','border-chassis-600','text-chassis-100');
        b.classList.add('bg-chassis-900','border-chassis-800','text-chassis-400');
      });
      btn.classList.remove('bg-chassis-900','border-chassis-800','text-chassis-400');
      btn.classList.add('bg-chassis-800','border-chassis-600','text-chassis-100');
      cards.forEach((card) => {
        const cp = card.getAttribute('data-purpose');
        if (purpose === 'all' || cp === purpose) {
          card.style.display = '';
        } else {
          card.style.display = 'none';
        }
      });
    });
  });
</script>
