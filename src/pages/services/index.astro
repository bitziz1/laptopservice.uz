---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ServiceCard from "@/components/ServiceCard.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import IconLink from "@/components/IconLink.astro";
import { servicesData } from "@/data/services";
import { siteConfig } from "@/data/siteConfig";

const breadcrumbs = [
  { name: "Услуги", url: "/services" },
];
---

<BaseLayout
  title="Услуги ремонта ноутбуков в Ташкенте"
  description="Компонентный ремонт материнских плат, BGA-пайка, чистка от пыли с заменой термоинтерфейса, ультразвуковая чистка после залития на ул. Паркент 11."
  breadcrumbs={breadcrumbs}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 space-y-8">
    
    <Breadcrumbs items={breadcrumbs} />

    <div class="max-w-3xl space-y-3">
      <div class="text-xs font-sans text-chassis-400 uppercase tracking-wider">Сервисный центр</div>
      <h1 class="text-2xl sm:text-4xl font-extrabold text-chassis-100 tracking-tight">
        Услуги по ремонту ноутбуков и компьютеров
      </h1>
      <p class="text-xs sm:text-sm text-chassis-300 leading-relaxed">
        Проблемы с вашим ноутбуком? Привозите, посмотрим и поможем.
      </p>
    </div>

    <!-- Services Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
      {servicesData.map((service) => (
        <ServiceCard service={service} />
      ))}
    </div>

    <!-- Builds Banner -->
    <div class="rounded-lg border border-chassis-700 bg-chassis-850 p-6 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="text-xs text-chassis-300 space-y-1">
        <div class="font-bold text-chassis-100 text-sm">Нужна сборка ПК с нуля?</div>
        <div>Собираем игровые, офисные и AI-станции под ваш бюджет с гарантией. Посмотрите готовые примеры.</div>
      </div>
      <a href="/builds" class="px-5 py-2.5 rounded border border-chassis-600 bg-chassis-800 hover:bg-chassis-700 text-chassis-100 text-xs font-sans font-bold transition-colors shrink-0">
        Сборки ПК →
      </a>
    </div>

    <!-- Direct CTA -->
    <div class="rounded-lg border border-chassis-800 bg-chassis-950 p-6 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="text-xs text-chassis-300 text-center sm:text-left">
        <span class="text-chassis-100 font-bold block">Не нашли описание вашей проблемы?</span>
        <span>Опишите симптомы дежурному мастеру в Telegram.</span>
      </div>

      <IconLink
        type="telegram"
        href={siteConfig.telegram.masterUrl}
        label="Написать в Telegram"
        ariaLabel="Написать в Telegram"
        variant="button"
        target="_blank"
        class="px-5 py-2.5 border-chassis-600 bg-chassis-800 hover:bg-chassis-700 text-chassis-100 font-bold"
      />
    </div>

  </div>
</BaseLayout>