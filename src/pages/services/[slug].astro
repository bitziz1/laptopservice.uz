---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import IconLink from "@/components/IconLink.astro";
import { servicesData, type ServiceItem, complexityConfig } from "@/data/services";
import { siteConfig } from "@/data/siteConfig";

export function getStaticPaths() {
  return servicesData.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

interface Props {
  service: ServiceItem;
}

const { service } = Astro.props;

const breadcrumbs = [
  { name: "Услуги", url: "/services" },
  { name: service.title, url: `/services/${service.slug}` },
];
---

<BaseLayout
  title={`${service.title} в Ташкенте`}
  description={`${service.shortDescription} Сервисный центр Laptop Service на ул. Паркент 11. Опыт 20 лет, согласование стоимости до ремонта.`}
  type="Service"
  serviceData={{
    name: service.title,
    description: service.fullDescription,
  }}
  faqList={service.faq}
  breadcrumbs={breadcrumbs}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 space-y-10">
    
    <Breadcrumbs items={breadcrumbs} />

    <!-- Service Header -->
    <header class="space-y-4">
      <div class="text-xs font-sans text-chassis-400 uppercase tracking-wider">
        Услуга сервисного центра • ул. Паркент 11
      </div>

      <h1 class="text-2xl sm:text-4xl font-extrabold text-chassis-100 tracking-tight leading-tight">
        {service.title}
      </h1>

      <p class="text-sm sm:text-base text-chassis-300 leading-relaxed">
        {service.fullDescription}
      </p>

      <!-- Complexity -->
      <div class="pt-2">
        <span class="text-xs font-sans font-bold uppercase tracking-wider text-chassis-300">
          {complexityConfig[service.complexity].label}
        </span>
      </div>
    </header>

    <!-- Symptoms Checklist -->
    <section class="space-y-3">
      <h2 class="text-sm font-bold text-chassis-200 uppercase font-sans tracking-wider">
        Характерные признаки
      </h2>
      <div class="space-y-2">
        {service.symptoms.map((symptom) => (
          <div class="text-xs text-chassis-300 flex items-start gap-2.5 leading-relaxed">
            <span class="text-chassis-500 mt-0.5">—</span>
            <span>{symptom}</span>
          </div>
        ))}
      </div>
    </section>

    <!-- Stages of Work -->
    <section class="space-y-4">
      <h2 class="text-sm font-bold text-chassis-200 uppercase font-sans tracking-wider">
        Порядок проведения работ
      </h2>
      <div class="space-y-4">
        {service.stages.map((stage, idx) => (
          <div class="space-y-1">
            <div class="text-xs font-sans text-chassis-100 font-bold">0{idx + 1}. {stage.title}</div>
            <p class="text-xs text-chassis-400 leading-relaxed">{stage.description}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- FAQ -->
    {service.faq && service.faq.length > 0 && (
      <section class="space-y-4 pt-6">
        <h2 class="text-sm font-bold text-chassis-200 uppercase font-sans tracking-wider">
          Частые вопросы
        </h2>
        <div class="space-y-4">
          {service.faq.map((item) => (
            <div class="space-y-1">
              <h3 class="text-xs font-bold text-chassis-100">{item.question}</h3>
              <p class="text-xs text-chassis-400 leading-relaxed">{item.answer}</p>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- Direct CTA Banner -->
    <div class="rounded-lg border border-chassis-700 bg-chassis-950 p-6 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="text-xs text-chassis-300 text-center sm:text-left space-y-1">
        <div class="font-bold text-chassis-100">Нужна консультация по услуге «{service.title}»?</div>
        <div>Свяжитесь с мастером напрямую для уточнения деталей.</div>
      </div>

      <div class="flex items-center gap-2">
        <IconLink
          type="telegram"
          href={siteConfig.telegram.masterUrl}
          label="Telegram"
          ariaLabel="Написать в Telegram"
          variant="button"
          target="_blank"
          class="border-chassis-600 bg-chassis-800 hover:bg-chassis-700 text-chassis-100 font-bold"
        />
        <IconLink
          type="phone"
          href={`tel:${siteConfig.phones.primary}`}
          label="Позвонить"
          ariaLabel="Позвонить"
          variant="button"
          class="border-chassis-700 bg-chassis-900 hover:bg-chassis-800 text-chassis-200"
        />
      </div>
    </div>

  </div>
</BaseLayout>