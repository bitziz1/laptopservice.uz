---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import IconLink from "@/components/IconLink.astro";
import ServiceAnimation from "@/components/ServiceAnimation.astro";
import { Picture } from "astro:assets";
import { getCollection, render } from "astro:content";
import { siteConfig } from "@/data/siteConfig";
import VisualService from "@/components/VisualService";
import fs from "node:fs";
import client from "../../../tina/__generated__/client";

const SERVICE_QUERY = `query($relativePath:String!){ services(relativePath:$relativePath){ title shortDescription fullDescription promptSubject promptMotionA promptMotionB promptBucket promptTone body } }`;

export async function getStaticPaths() {
  const services = await getCollection("services");
  return services.map((entry) => {
    const slug = entry.id.split("/").pop()!.replace(/\.md$/, "");
    return {
      params: { slug },
      props: { entry },
    };
  });
}

interface Props {
  entry: any;
}

const { entry } = Astro.props as { entry: any };
const slug: string = entry.id.split("/").pop()!.replace(/\.md$/, "");

// Tina Visual Editing — live query when `tinacms dev` on 4001 is running, fallback to astro:content
let tinaData: any = null;
let tinaError: string | null = null;
let tinaRelativePath: string = (entry as any).id as string;
if (!tinaRelativePath.endsWith(".md")) tinaRelativePath += ".md";
const tinaVariables = { relativePath: tinaRelativePath };
let tinaPayload: any = null;
try {
  const gqlRes = await fetch("http://localhost:4001/graphql", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ query: SERVICE_QUERY, variables: tinaVariables }),
  });
  if (gqlRes.ok) {
    const json: any = await gqlRes.json();
    if (json?.data?.services) {
      tinaData = json.data.services;
      tinaPayload = { query: SERVICE_QUERY, variables: tinaVariables, data: json.data };
    } else tinaError = json?.errors?.[0]?.message ?? "no data";
  } else tinaError = `http ${gqlRes.status}`;
} catch (e: any) {
  tinaError = e?.message ?? String(e);
  try {
    const res = await client.queries.services({ relativePath: tinaRelativePath });
    tinaData = res?.data?.services ?? null;
    if (tinaData) {
      tinaPayload = { query: res.query, variables: res.variables, data: res.data };
      tinaError = null;
    }
  } catch {}
}
const isTina = !!tinaData;
const raw = isTina ? tinaData : entry.data;
const service = raw;
const { Content } = await render(entry);
// media — только прозрачные public файлы webp/webm (исходники в content не используются на сайте, png/mp4/jpg не храним)
let anim: { webm: string; poster: string; alt: string } | undefined;
let pubImg: string | undefined;
const baseAlt = `${service.title} — анимация`;
try {
  const webmPath = `public/videos/services/${slug}.webm`;
  if (fs.existsSync(webmPath)) {
    const poster = fs.existsSync(`public/videos/services/${slug}-poster.webp`) ? `/videos/services/${slug}-poster.webp` : "";
    anim = {
      webm: `/videos/services/${slug}.webm`,
      poster: poster || "",
      alt: baseAlt,
    };
  }
  const webp = `public/images/services/${slug}.webp`;
  if (fs.existsSync(webp)) pubImg = `/images/services/${slug}.webp`;
} catch {}

const telegramHref = `${siteConfig.telegram.masterUrl}${siteConfig.telegram.masterUrl.includes("?") ? "&" : "?"}text=${encodeURIComponent(`Меня интересует ${service.title}. Модель устройства: `)}`;

const breadcrumbs = [
  { name: "Услуги", url: "/services" },
  { name: service.title, url: `/services/${slug}` },
];
---

<BaseLayout
  title={service.title.includes("в Ташкенте") ? service.title : `${service.title} в Ташкенте`}
  description={service.shortDescription.includes("в Ташкенте") ? `${service.shortDescription} Laptop Service (laptopservice.uz) — опыт 20 лет, Telegram @laptopservice_master, согласование до ремонта.` : `${service.shortDescription} Laptop Service (laptopservice.uz) в Ташкенте — опыт 20 лет, Telegram @laptopservice_master, согласование до ремонта.`}
  type="Service"
  serviceData={{
    name: service.title,
    description: service.fullDescription,
  }}
  breadcrumbs={breadcrumbs}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 space-y-10">
    
    <Breadcrumbs items={breadcrumbs} />

    {/* media — прозрачные, вне isTina чтобы в dev:tina тоже видно — видео и фото одинаковый визуальный размер */}
    {pubImg ? (
      <div class="w-full rounded-xl overflow-hidden border border-chassis-800 bg-[#171A20] flex items-center justify-center p-4">
        <img src={pubImg} alt={service.title} class="w-full h-auto object-contain max-h-[420px]" loading="eager" decoding="async" />
      </div>
    ) : anim ? (
      <div class="w-full rounded-xl overflow-hidden border border-chassis-800 bg-[#171A20] flex items-center justify-center p-4">
        <ServiceAnimation
          webm={anim.webm}
          poster={anim.poster}
          alt={anim.alt}
          class="w-full max-h-[420px]"
        />
      </div>
    ) : null}

    {isTina && tinaPayload ? (
      <VisualService client:load query={tinaPayload.query} variables={tinaPayload.variables} data={tinaPayload.data} />
    ) : (
      <>
        <!-- Service Header -->
        <header class="space-y-4">
          <div class="text-xs font-sans text-chassis-400 uppercase tracking-wider">
            Laptop Service • laptopservice.uz • <a href="/contacts" class="hover:text-chassis-200 underline underline-offset-2">Контакты</a>
            {import.meta.env.DEV && <span class="text-chassis-500 text-[10px] ml-2">{tinaError ? `Tina err: ${tinaError}` : "Tina offline"}</span>}
          </div>

          <h1 class="text-2xl sm:text-4xl font-extrabold text-chassis-100 tracking-tight leading-tight">
            {service.title}
          </h1>

          <p class="text-sm sm:text-base text-chassis-300 leading-relaxed">
            {service.fullDescription}
          </p>
        </header>

        <!-- Body — симптомы/этапы/FAQ из markdown (как в cases) -->
        <article class="prose prose-invert prose-sm max-w-none prose-headings:font-bold prose-headings:text-chassis-100 prose-p:text-chassis-300 prose-li:text-chassis-300 prose-strong:text-chassis-100 prose-a:text-sky-400 hover:prose-a:text-sky-300">
          <Content />
        </article>
      </>
    )}

    {slug === "remont-monobloka" && (
      <section class="space-y-3">
        <h2 class="text-sm font-bold text-chassis-200 uppercase font-sans tracking-wider">Что мы чиним в моноблоках</h2>
        <p class="text-xs text-chassis-400 leading-relaxed">Моноблок — гибрид монитора и системника в одном корпусе. Выбирайте конкретную услугу кластера — каждая страница заточена под свой запрос и содержит детали по разборке на клею/болтах, диагностике и срокам в Ташкенте.</p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          {[
            {slug:"diagnostika-monobloka", title:"Диагностика моноблока"},
            {slug:"remont-materinskoy-platy-monobloka", title:"Ремонт платы моноблока"},
            {slug:"zamena-matritsy-monobloka", title:"Замена матрицы моноблока"},
            {slug:"remont-bloka-pitaniya-monobloka", title:"Ремонт блока питания"},
            {slug:"sborka-razborka-monobloka", title:"Сборка и разборка на клею/болтах"},
            {slug:"chistka-monobloka-ot-pyli", title:"Чистка от пыли"},
            {slug:"remont-monobloka-posle-zalitiya", title:"После залития"},
            {slug:"zamena-nakopitelya-monobloka", title:"Замена HDD/SSD"},
            {slug:"remont-videokarty-monobloka", title:"Ремонт видеокарты"},
          ].map((item: any) => (
            <a href={`/services/${item.slug}`} class="text-xs text-sky-400 hover:text-sky-300 hover:underline flex gap-1.5"><span>—</span><span>{item.title} →</span></a>
          ))}
        </div>
      </section>
    )}

    <!-- Direct CTA Banner -->
    <div class="rounded-lg border border-chassis-700 bg-chassis-950 p-6 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="text-xs text-chassis-300 text-center sm:text-left space-y-1">
        <div class="font-bold text-chassis-100">Нужна консультация по услуге «{service.title}»?</div>
        <div>Свяжитесь с мастером напрямую для уточнения деталей.</div>
      </div>

      <div class="flex items-center gap-2">
        <IconLink
          type="telegram"
          href={telegramHref}
          label="Узнать стоимость"
          ariaLabel="Узнать стоимость в Telegram"
          variant="button"
          target="_blank"
          class="border-chassis-600 bg-chassis-800 hover:bg-chassis-700 text-chassis-100 font-bold"
        />
        <IconLink
          type="phone"
          href={`tel:${siteConfig.phones.primary}`}
          label="Позвонить"
          ariaLabel="Позвонить"
          variant="button"
          class="border-chassis-700 bg-chassis-900 hover:bg-chassis-800 text-chassis-200"
        />
      </div>
    </div>

  </div>
</BaseLayout>