---
import BaseLayout from "@/layouts/BaseLayout.astro";
import CaseCard from "@/components/CaseCard.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import IconLink from "@/components/IconLink.astro";
import { casesData } from "@/data/cases";
import { siteConfig } from "@/data/siteConfig";

const breadcrumbs = [
  { name: "Наши работы", url: "/cases" },
];
---

<BaseLayout
  title="Наши работы — примеры ремонтов ноутбуков, сервисный центр на Паркент 11"
  description="Наши работы: реальные разборы ремонтов ноутбуков из Telegram-канала @laptopservice_uz — замеры, BGA-пайка, восстановление после залития."
  breadcrumbs={breadcrumbs}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 space-y-8">
    
    <Breadcrumbs items={breadcrumbs} />

    <div class="max-w-3xl space-y-3">
      <div class="text-xs font-sans text-chassis-400 uppercase tracking-wider">
        Telegram-канал: {siteConfig.telegram.channel}
      </div>
      <h1 class="text-2xl sm:text-4xl font-extrabold text-chassis-100 tracking-tight">
        Наши работы
      </h1>
      <p class="text-xs sm:text-sm text-chassis-300 leading-relaxed">
        Реальные примеры из практики.
      </p>
    </div>

    <!-- Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
      {casesData.map((caseItem) => (
        <CaseCard caseItem={caseItem} />
      ))}
    </div>

    <!-- Telegram Channel Strip -->
    <div class="rounded-lg border border-chassis-800 bg-chassis-950 p-6 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="text-xs text-chassis-300 text-center sm:text-left space-y-1">
        <span class="text-chassis-100 font-bold block">Следите за новыми публикациями в Telegram</span>
        <span>Регулярно выкладываем замеры, фото под микроскопом и результаты стресс-тестов.</span>
      </div>

      <IconLink
        type="telegram-channel"
        href={siteConfig.telegram.channelUrl}
        label="Канал @laptopservice_uz →"
        ariaLabel="Telegram-канал @laptopservice_uz"
        variant="button"
        target="_blank"
        class="shrink-0"
      />
    </div>

  </div>
</BaseLayout>