---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import IconLink from "@/components/IconLink.astro";
import { casesData, type CaseItem } from "@/data/cases";
import { siteConfig } from "@/data/siteConfig";

export function getStaticPaths() {
  return casesData.map((caseItem) => ({
    params: { slug: caseItem.slug },
    props: { caseItem },
  }));
}

interface Props {
  caseItem: CaseItem;
}

const { caseItem } = Astro.props;

const breadcrumbs = [
  { name: "Наши работы", url: "/cases" },
  { name: caseItem.device, url: `/cases/${caseItem.slug}` },
];

const solutionSteps = caseItem.solution
  .split("\n")
  .map((line) => line.trim())
  .filter((line) => line.length > 0)
  .map((line, idx) => ({
    name: `Этап ${idx + 1}`,
    text: line.replace(/^\d+\.\s*/, ""),
  }));
---

<BaseLayout
  title={`${caseItem.title}`}
  description={`${caseItem.problem.slice(0, 150)}... Разбор ремонта в сервисном центре Laptop Service на Паркент 11.`}
  type="HowTo"
  howToSteps={solutionSteps}
  breadcrumbs={breadcrumbs}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 space-y-8">
    
    <Breadcrumbs items={breadcrumbs} />

    <!-- Case Header -->
    <header class="space-y-3">
      <div class="flex flex-wrap items-center gap-2 text-xs font-sans">
        <span class="text-chassis-400 font-bold uppercase tracking-wider">
          {caseItem.category}
        </span>
        <span class="text-chassis-400">
          • {caseItem.date}
        </span>
      </div>

      <h1 class="text-xl sm:text-3xl font-extrabold text-chassis-100 tracking-tight leading-tight">
        {caseItem.title}
      </h1>

      <div class="text-xs font-sans text-chassis-300">
        Устройство: <strong class="text-chassis-100">{caseItem.device}</strong>
      </div>
    </header>

    <!-- Specs Box -->
    {caseItem.keySpecs && (
      <div class="py-2 space-y-3">
        <div class="text-xs font-sans text-chassis-400 uppercase tracking-wider">Параметры ремонта</div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
          {caseItem.keySpecs.map((spec) => (
            <div class="space-y-1">
              <span class="text-chassis-400 block text-[11px] uppercase tracking-wider">{spec.label}</span>
              <span class="text-chassis-200 font-bold font-mono">{spec.value}</span>
            </div>
          ))}
        </div>
      </div>
    )}

    <!-- Problem -->
    <section class="py-4 space-y-2">
      <div class="text-xs font-sans text-chassis-400 uppercase tracking-wider font-bold">
        01 — Неисправность и симптомы
      </div>
      <p class="text-xs sm:text-sm text-chassis-300 leading-relaxed">
        {caseItem.problem}
      </p>
    </section>

    <!-- Diagnosis -->
    <section class="py-4 space-y-2">
      <div class="text-xs font-sans text-chassis-400 uppercase tracking-wider font-bold">
        02 — Результаты диагностики
      </div>
      <p class="text-xs sm:text-sm text-chassis-300 leading-relaxed">
        {caseItem.diagnosis}
      </p>
    </section>

    <!-- Steps -->
    <section class="py-4 space-y-3">
      <div class="text-xs font-sans text-chassis-400 uppercase tracking-wider font-bold">
        03 — Ход выполнения
      </div>

      <div class="space-y-3">
        {solutionSteps.map((step, idx) => (
          <div class="text-xs text-chassis-300 flex items-start gap-2.5 leading-relaxed">
            <span class="text-chassis-100 font-bold">{idx + 1}.</span>
            <span>{step.text}</span>
          </div>
        ))}
      </div>
    </section>

    <!-- Result -->
    <section class="py-4 space-y-2">
      <div class="text-xs font-sans text-chassis-400 uppercase tracking-wider font-bold">
        04 — Итог и тестирование
      </div>
      <p class="text-xs sm:text-sm text-chassis-300 leading-relaxed">
        {caseItem.result}
      </p>
    </section>

    <!-- Tags -->
    <div class="flex flex-wrap gap-2 pt-2">
      {caseItem.tags.map((tag) => (
        <span class="text-[11px] font-sans text-sky-400">
          #{tag}
        </span>
      ))}
    </div>

    <!-- CTA -->
    <div class="rounded-lg border border-chassis-700 bg-chassis-950 p-6 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="text-xs text-chassis-300 text-center sm:text-left space-y-1">
        <div class="font-bold text-chassis-100">Похожая проблема с ноутбуком {caseItem.device}?</div>
        <div>Привезите устройство на диагностику на ул. Паркент 11 или отправьте доставкой.</div>
      </div>

      <div class="flex items-center gap-2">
        <IconLink
          type="telegram"
          href={siteConfig.telegram.masterUrl}
          label="Telegram"
          ariaLabel="Написать в Telegram"
          variant="button"
          target="_blank"
          class="border-chassis-600 bg-chassis-800 hover:bg-chassis-700 text-chassis-100 font-bold"
        />
        <IconLink
          type="phone"
          href={`tel:${siteConfig.phones.primary}`}
          label="Позвонить"
          ariaLabel="Позвонить"
          variant="button"
          class="border-chassis-700 bg-chassis-900 hover:bg-chassis-800 text-chassis-200"
        />
      </div>
    </div>

  </div>
</BaseLayout>