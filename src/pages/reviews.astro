---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import ReviewCard from "@/components/ReviewCard.astro";
import VisualReviews from "@/components/VisualReviews";
import IconLink from "@/components/IconLink.astro";
import { siteConfig } from "@/data/siteConfig";

const breadcrumbs = [
  { name: "Отзывы", url: "/reviews" },
];

const reviewsEntries = await getCollection("reviews");
reviewsEntries.sort((a,b)=> b.data.date.getTime() - a.data.date.getTime());
const reviewsForCard = reviewsEntries.map((e) => ({
  id: e.id,
  author: e.data.author,
  source: e.data.source,
  rating: e.data.rating,
  date: e.data.date.toISOString().slice(0,10),
  device: e.data.device,
  text: e.body?.trim() ?? "",
  avatar: e.data.avatar ?? null,
  gallery: e.data.gallery ?? [],
  captions: e.data.captions ?? [],
}));

const REVIEWS_TINA_QUERY = `query{ reviewsConnection{ edges{ node{ id _sys{ filename relativePath } author source rating date device avatar gallery captions body } } } }`;
let tinaReviewsPayload: any = null;
let isTinaReviews = false;
try {
  const r = await fetch("http://localhost:4001/graphql", { method:"POST", headers:{ "Content-Type":"application/json"}, body: JSON.stringify({ query: REVIEWS_TINA_QUERY })});
  if(r.ok){ const j:any = await r.json(); if(j.data?.reviewsConnection){ tinaReviewsPayload = { query: REVIEWS_TINA_QUERY, variables: {}, data: j.data }; isTinaReviews = true; } }
} catch {}
---

<BaseLayout
  title="Отзывы клиентов о Laptop Service в Ташкенте"
  description="Отзывы клиентов о сервисном центре Laptop Service на ул. Паркент 11. Оценки и отзывы с Яндекс Карт и Google Maps с фото выполненных работ."
  breadcrumbs={breadcrumbs}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 space-y-8">
    
    <Breadcrumbs items={breadcrumbs} />

    <header class="max-w-3xl space-y-3">
      <div class="text-xs font-sans text-chassis-400 uppercase tracking-wider">
        Верифицированные отзывы
      </div>

      <h1 class="text-2xl sm:text-4xl font-extrabold text-chassis-100 tracking-tight">
        Отзывы клиентов сервисного центра
      </h1>

      <p class="text-xs sm:text-sm text-chassis-300 leading-relaxed">
        Реальные отзывы посетителей из профилей на Яндекс Картах, Google Maps и 2GIS с фотографиями выполненных работ и замеров.
      </p>
    </header>

    <!-- Rating Summary + Оставить отзыв -->
    <div class="space-y-4">
      <div class="flex flex-col sm:flex-row items-center justify-between gap-4 py-2">
        <div class="flex items-center gap-4 text-xs font-sans">
          <div class="text-2xl sm:text-3xl font-bold text-chassis-100">5.0</div>
          <div class="text-chassis-300">
            <div>★★★★★ (Отличная оценка)</div>
            <div class="text-chassis-400 text-[11px]">Профили на картах Ташкента</div>
          </div>
        </div>
      </div>

      <div class="space-y-2">
        <div class="text-sm font-bold text-chassis-100">Оставить свой отзыв</div>
        <div class="flex flex-col sm:flex-row gap-3">
          <IconLink
            type="yandex-maps"
            href={siteConfig.socials.yandexMaps}
            label="Оставить отзыв на Яндекс Картах"
            ariaLabel="Оставить отзыв на Яндекс Картах"
            variant="button"
            target="_blank"
            class="px-6 py-3.5 text-sm font-bold flex-1 justify-center"
          />
          <IconLink
            type="google-maps"
            href={siteConfig.socials.googleMaps}
            label="Оставить отзыв на Google Maps"
            ariaLabel="Оставить отзыв на Google Maps"
            variant="button"
            target="_blank"
            class="px-6 py-3.5 text-sm font-bold flex-1 justify-center"
          />
          <IconLink
            type="2gis"
            href={siteConfig.socials.twoGis}
            label="Оставить отзыв в 2ГИС"
            ariaLabel="Оставить отзыв в 2ГИС"
            variant="button"
            target="_blank"
            class="px-6 py-3.5 text-sm font-bold flex-1 justify-center"
          />
        </div>
      </div>
    </div>

    <!-- Grid — MD из content/reviews/*.md (Obsidian) — разная высота карточек -->
    {isTinaReviews && tinaReviewsPayload ? (
      <VisualReviews client:load query={tinaReviewsPayload.query} variables={tinaReviewsPayload.variables} data={tinaReviewsPayload.data} variant="page" />
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 items-start auto-rows-auto">
        {reviewsForCard.map((review) => (
          <ReviewCard review={review as any} />
        ))}
      </div>
    )}

    <!-- Direct CTA -->
    <div class="rounded-lg border border-chassis-700 bg-chassis-950 p-6 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="text-xs text-chassis-300 text-center sm:text-left space-y-1">
        <div class="font-bold text-chassis-100">Нужен ремонт ноутбука?</div>
        <div>Напишите мастеру в Telegram или позвоните по телефону.</div>
      </div>

      <div class="flex items-center gap-2">
        <IconLink
          type="telegram"
          href={siteConfig.telegram.masterUrl}
          label="Telegram"
          ariaLabel="Написать в Telegram"
          variant="button"
          target="_blank"
          class="border-chassis-600 bg-chassis-800 hover:bg-chassis-700 text-chassis-100 font-bold"
        />
        <IconLink
          type="phone"
          href={`tel:${siteConfig.phones.primary}`}
          label={siteConfig.phones.displayPrimary}
          ariaLabel="Позвонить"
          variant="button"
          class="border-chassis-700 bg-chassis-900 hover:bg-chassis-800 text-chassis-200"
        />
      </div>
    </div>

  </div>

  <script is:inline>
    document.addEventListener('click', function(e) {
      var btn = e.target.closest('.review-more');
      if (!btn) return;
      var wrap = btn.closest('.review-text-wrap');
      if (!wrap) return;
      var shortEl = wrap.querySelector('.review-short');
      var fullEl = wrap.querySelector('.review-full');
      if (!shortEl || !fullEl) return;
      var isExpanded = !fullEl.classList.contains('hidden');
      if (isExpanded) {
        fullEl.classList.add('hidden');
        shortEl.classList.remove('hidden');
        btn.textContent = 'ещё';
      } else {
        shortEl.classList.add('hidden');
        fullEl.classList.remove('hidden');
        btn.textContent = 'свернуть';
      }
    });
  </script>
</BaseLayout>