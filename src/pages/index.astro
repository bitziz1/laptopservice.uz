---
import { Picture } from "astro:assets";
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import IconLink from "@/components/IconLink.astro";
import ThreadsScroller from "@/components/ThreadsScroller.astro";
import FaqAccordion from "@/components/FaqAccordion.astro";
import VisualThreadsHome from "@/components/VisualThreadsHome";
import VisualReviews from "@/components/VisualReviews";
import { siteConfig } from "@/data/siteConfig";
import { servicesData } from "@/data/services";
import { formatDateRu } from "@/utils/formatDate";

// Контент: content/{cases,builds,reviews,threads}/*.md — 1 файл = 1 запись, открывается в Obsidian
const casesEntries = await getCollection("cases");
const buildsEntries = await getCollection("builds");
const reviewsEntries = await getCollection("reviews");
casesEntries.sort((a,b)=> b.data.date.getTime() - a.data.date.getTime());
buildsEntries.sort((a,b)=> b.data.date.getTime() - a.data.date.getTime());
reviewsEntries.sort((a,b)=> b.data.date.getTime() - a.data.date.getTime());

// Tina live: тредсы и отзывы на главной — подсветка в админке на руте "/" (router threads -> "/", reviews -> "/reviews")
const THREADS_TINA_QUERY = `query{ threadsConnection{ edges{ node{ id _sys{ filename relativePath } handle date gallery alts url body } } } }`;
const REVIEWS_TINA_QUERY = `query{ reviewsConnection{ edges{ node{ id _sys{ filename relativePath } author source rating date device avatar gallery captions body } } } }`;
let tinaThreadsPayload: any = null;
let tinaReviewsPayload: any = null;
let isTinaThreads = false;
let isTinaReviews = false;
try {
  const r = await fetch("http://localhost:4001/graphql", { method:"POST", headers:{ "Content-Type":"application/json"}, body: JSON.stringify({ query: THREADS_TINA_QUERY })});
  if(r.ok){ const j:any = await r.json(); if(j.data?.threadsConnection){ tinaThreadsPayload = { query: THREADS_TINA_QUERY, variables: {}, data: j.data }; isTinaThreads = true; } }
} catch {}
try {
  const r = await fetch("http://localhost:4001/graphql", { method:"POST", headers:{ "Content-Type":"application/json"}, body: JSON.stringify({ query: REVIEWS_TINA_QUERY })});
  if(r.ok){ const j:any = await r.json(); if(j.data?.reviewsConnection){ tinaReviewsPayload = { query: REVIEWS_TINA_QUERY, variables: {}, data: j.data }; isTinaReviews = true; } }
} catch {}

const homeFaq = [
  {
    question: "Как узнать стоимость ремонта моего ноутбука?",
    answer: "Точная стоимость определяется после аппаратной диагностики в сервисном центре. Мастер связывается с вами, объясняет причину неисправности и называет фиксированную цену работ и необходимых деталей. Ремонт начинается строго после вашего согласия."
  },
  {
    question: "Как передать ноутбук на диагностику?",
    answer: "Вы можете привезти устройство лично в сервисный центр по адресу ул. Паркент 11 (напротив Паркентского базара) или отправить через службу доставки (Яндекс Доставка / курьер)."
  },
  {
    question: "Сколько времени занимает диагностика?",
    answer: "В большинстве случаев первичная аппаратная диагностика на приборах занимает от 40 минут до 2 часов. При плавающих дефектах — до 24 часов."
  },
  {
    question: "Предоставляется ли гарантия на выполненный ремонт?",
    answer: "Да, на все выполненные работы по BGA-пайке и компонентному ремонту цепей питания предоставляется гарантия сервисного центра."
  }
];
---

<BaseLayout
  title="Laptop Service — Ремонт ноутбуков в Ташкенте"
  description="Сервисный центр по ремонту ноутбуков в Ташкенте (ул. Паркент 11). Компонентный ремонт материнских плат, BGA-пайка, чистка от пыли, восстановление после залития. Согласование стоимости до ремонта."
  type="LocalBusiness"
  faqList={homeFaq}
>
  
  <!-- HERO SECTION -->
  <section class="py-12 sm:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl space-y-5">
        
        <div class="text-xs font-sans text-chassis-400 uppercase tracking-wider">
          Сервисный центр • г. Ташкент, ул. Паркент 11
        </div>

        <h1 class="text-2xl sm:text-4xl lg:text-5xl font-extrabold text-chassis-100 tracking-tight leading-tight">
          Надежный сервис по ремонту ноутбуков в Ташкенте
        </h1>
      </div>

      <!-- Threads лента — на всю ширину страницы -->
      <div class="mt-6 max-w-7xl">
        {isTinaThreads && tinaThreadsPayload ? (
          <VisualThreadsHome client:load query={tinaThreadsPayload.query} variables={tinaThreadsPayload.variables} data={tinaThreadsPayload.data} />
        ) : (
          <ThreadsScroller />
        )}
      </div>

      <div class="max-w-3xl mx-auto space-y-5 mt-6">

        <!-- SEO / LLM fallback — оставляем все лейблы для сканирования, скрыто визуально -->
        <div class="sr-only" aria-hidden="false">
          <p>Компонентный ремонт, BGA-пайка видеочипов и процессоров, восстановление плат после залития и перепадов напряжения. Работаем с 2004 года.</p>
          <div>
            <h2>Сломался ноутбук? Вот что нужно сделать:</h2>
            <ol>
              <li>Принесите ноутбук в наш сервисный центр в Ташкенте: ул. Паркент, 11.</li>
              <li>Оставьте ноутбук на диагностику. Мастер проверит ноутбук и найдёт проблему.</li>
              <li>Мы свяжемся с вами и сообщим стоимость ремонта. Начнём ремонт только после того, как вы его одобрите.</li>
            </ol>
          </div>
        </div>
        <noscript>
          <p class="text-sm sm:text-base text-chassis-300 leading-relaxed">Компонентный ремонт, BGA-пайка видеочипов и процессоров, восстановление плат после залития и перепадов напряжения. Работаем с 2004 года.</p>
          <div class="text-xs font-sans text-chassis-300 space-y-1 leading-relaxed">
            <div class="font-bold text-chassis-100 uppercase tracking-wider">Сломался ноутбук? Вот что нужно сделать:</div>
            <p>1. Принесите ноутбук в наш сервисный центр в Ташкенте: ул. Паркент, 11.<br />2. Оставьте ноутбук на диагностику. Мастер проверит ноутбук и найдёт проблему.<br />3. Мы свяжемся с вами и сообщим стоимость ремонта. Начнём ремонт только после того, как вы его одобрите.</p>
          </div>
        </noscript>

        <!-- CTA — Instagram profile style, 2 rows — на всю ширину до 640, дальше центрирован -->
        <div class="space-y-2 pt-2 w-full sm:max-w-[520px] sm:mx-auto">
          <!-- Big animated call button — fills over 3s, tall -->
          <a href={`tel:${siteConfig.phones.primary}`} aria-label="Позвонить" class="relative overflow-hidden flex items-center justify-center gap-2 w-full py-4 rounded-xl border border-chassis-600 bg-chassis-800 text-chassis-100 font-bold text-sm tracking-wide group">
            <span class="absolute inset-0 bg-chassis-600 origin-left animate-[heroFill_3s_ease-out_forwards]"></span>
            <span class="relative flex items-center gap-2">
              <img src="/phone.svg" alt="" width="16" height="16" class="w-4 h-4 object-contain" aria-hidden="true" />
              Позвонить: {siteConfig.phones.displayPrimary}
              <span class="ml-1">›</span>
            </span>
          </a>
          <!-- Two equal buttons: Location + Message -->
          <div class="grid grid-cols-2 gap-2">
            <a href="#location" aria-label="Адрес и локация" class="flex items-center justify-center gap-1.5 py-3 rounded-xl border border-chassis-700 bg-chassis-850 hover:bg-chassis-800 text-chassis-100 text-xs font-sans font-bold transition-colors">
              <span class="flex items-center gap-1">
                <img src="/Yandex_Maps_icon.svg" alt="" width="14" height="14" class="w-3.5 h-3.5 object-contain" loading="lazy" />
                <img src="/Google_Maps_icon.svg" alt="" width="14" height="14" class="w-3.5 h-3.5 object-contain" loading="lazy" />
                <img src="/2gis.svg" alt="" width="14" height="14" class="w-3.5 h-3.5 object-contain" loading="lazy" />
              </span>
              Адрес и локация
            </a>
            <a href={siteConfig.telegram.masterUrl} target="_blank" rel="noopener noreferrer" aria-label="Сообщение в Telegram" class="flex items-center justify-center gap-1.5 py-3 rounded-xl border border-chassis-700 bg-chassis-850 hover:bg-chassis-800 text-chassis-100 text-xs font-sans font-bold transition-colors">
              <img src="/Telegram_Logo.svg" alt="" width="14" height="14" class="w-3.5 h-3.5 object-contain" loading="lazy" />
              Сообщение
            </a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- SERVICES CATALOG — threads-like horizontal scroller -->
  <section class="py-8 bg-chassis-950/50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-4">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-2">
        <div>
          <div class="text-xs font-sans text-chassis-400 uppercase tracking-wider">Услуги</div>
          <h2 class="text-xl sm:text-2xl font-bold text-chassis-100">Основные виды выполняемых работ</h2>
        </div>
        <a href="/services" class="text-xs font-sans text-chassis-300 hover:text-chassis-100 underline">
          Все услуги ({servicesData.length}) →
        </a>
      </div>
      <div class="horizontal-scroller flex gap-2.5 overflow-x-auto overflow-y-hidden pb-2 snap-x snap-mandatory scroll-smooth -mx-4 px-4 sm:mx-0 sm:px-0">
        {servicesData.map((service) => (
          <a href={`/services/${service.slug}`} class="group shrink-0 snap-start w-[270px] sm:w-[290px] bg-chassis-850 border border-chassis-800 rounded-[14px] overflow-hidden flex flex-col p-3.5 hover:border-chassis-700 hover:bg-chassis-800/60 transition-colors text-left">
            <div class="flex items-center gap-2 mb-2">
              <img src="/logo.svg" alt="" width="20" height="20" class="w-5 h-5 rounded-full bg-chassis-900 border border-chassis-800 shrink-0" loading="lazy" />
              <span class="text-[10px] font-sans uppercase tracking-wider text-chassis-500 group-hover:text-chassis-400">Laptop Service</span>
            </div>
            <h3 class="text-sm font-bold text-chassis-100 leading-tight line-clamp-2 group-hover:underline underline-offset-2">{service.title}</h3>
            <p class="text-xs text-chassis-400 leading-relaxed line-clamp-2 mt-1.5">{service.shortDescription}</p>
            <div class="mt-2 space-y-1">
              {service.symptoms.slice(0, 2).map((s) => (
                <div class="text-[11px] text-chassis-500 flex gap-1.5 leading-tight"><span class="text-chassis-600 shrink-0">—</span><span class="line-clamp-1">{s}</span></div>
              ))}
            </div>
            <span class="mt-auto pt-3 ml-auto self-end text-right text-[11px] font-sans font-bold text-chassis-300 group-hover:text-chassis-100">Подробнее →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- BUILDS PREVIEW — threads-like horizontal scroller -->
  <section class="py-8 bg-chassis-950/30">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-4">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-2">
        <div>
          <div class="text-xs font-sans text-chassis-400 uppercase tracking-wider">Сборка ПК • под ваш бюджет</div>
          <h2 class="text-xl sm:text-2xl font-bold text-chassis-100">Сборки ПК под задачу</h2>
        </div>
        <a href="/builds" class="text-xs font-sans text-chassis-300 hover:text-chassis-100 underline">
          Все сборки ({buildsEntries.length}) →
        </a>
      </div>
      <div class="horizontal-scroller flex gap-2.5 overflow-x-auto overflow-y-hidden pb-2 snap-x snap-mandatory scroll-smooth -mx-4 px-4 sm:mx-0 sm:px-0">
        {buildsEntries.map((entry) => {
          const slug = entry.id.replace(/\.md$/, "");
          const heroImage = (entry.data as any).heroImage as any;
          const gallery = (entry.data.gallery ?? []) as any[];
          const allImages = heroImage ? [heroImage, ...gallery] : gallery;
          const previewImages = allImages.slice(0, 2);
          return (
          <a href={`/builds/${slug}`} class="group shrink-0 snap-start w-[290px] sm:w-[310px] bg-chassis-850 border border-chassis-800 rounded-[14px] overflow-hidden flex flex-col p-3.5 hover:border-chassis-700 hover:bg-chassis-800/60 transition-colors text-left">
            <div class="flex items-center gap-2 mb-2">
              <img src="/logo.svg" alt="" width="20" height="20" class="w-5 h-5 rounded-full bg-chassis-900 border border-chassis-800 shrink-0" loading="lazy" />
              <span class="text-[10px] font-sans font-bold uppercase tracking-wider text-chassis-500">{entry.data.purposeLabel}</span>
            </div>
            {previewImages.length === 1 && (
              <div class="rounded-lg overflow-hidden border border-chassis-800 bg-chassis-900 mb-2.5">
                <Picture src={previewImages[0]} alt={entry.data.title} widths={[300, 600]} sizes="(max-width: 640px) 290px, 310px" formats={["avif", "webp"]} fallbackFormat="webp" loading="lazy" decoding="async" class="w-full h-[110px] object-cover" />
              </div>
            )}
            {previewImages.length >= 2 && (
              <div class="grid grid-cols-2 gap-1.5 mb-2.5">
                {previewImages.map((img) => (
                  <div class="rounded-lg overflow-hidden border border-chassis-800 bg-chassis-900">
                    <Picture src={img} alt={entry.data.title} widths={[180, 360]} sizes="140px" formats={["avif", "webp"]} fallbackFormat="webp" loading="lazy" decoding="async" class="w-full h-[90px] object-cover" />
                  </div>
                ))}
              </div>
            )}
            <h3 class="text-sm font-bold text-chassis-100 leading-tight line-clamp-2 group-hover:underline underline-offset-2">{entry.data.title}</h3>
            <p class="text-xs text-chassis-400 leading-relaxed line-clamp-2 mt-1.5">{entry.data.description}</p>
            <div class="mt-2 space-y-1 font-mono text-[11px]">
              {entry.data.components?.cpu && <div class="flex gap-1.5 leading-tight"><span class="text-chassis-600 shrink-0">CPU:</span><span class="text-chassis-400 line-clamp-1">{entry.data.components.cpu}</span></div>}
              {entry.data.components?.gpu && <div class="flex gap-1.5 leading-tight"><span class="text-chassis-600 shrink-0">GPU:</span><span class="text-chassis-400 line-clamp-1">{entry.data.components.gpu}</span></div>}
              {entry.data.components?.ram && <div class="flex gap-1.5 leading-tight"><span class="text-chassis-600 shrink-0">RAM:</span><span class="text-chassis-400 line-clamp-1">{entry.data.components.ram}</span></div>}
            </div>
            <span class="mt-auto pt-3 ml-auto self-end text-right text-[11px] font-sans font-bold text-chassis-300 group-hover:text-chassis-100">Смотреть характеристики →</span>
          </a>
        )})}
      </div>
    </div>
  </section>

  <!-- CASES FROM TELEGRAM — threads-like horizontal scroller -->
  <section class="py-8 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-4">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-2">
      <h2 class="text-xl sm:text-2xl font-bold text-chassis-100">Реальные примеры ремонтов</h2>
      <a href="/cases" class="text-xs font-sans text-chassis-300 hover:text-chassis-100 underline">
        Все работы ({casesEntries.length}) →
      </a>
    </div>
    <div class="horizontal-scroller flex gap-2.5 overflow-x-auto overflow-y-hidden pb-2 snap-x snap-mandatory scroll-smooth -mx-4 px-4 sm:mx-0 sm:px-0">
      {casesEntries.slice(0, 8).map((entry) => {
          const slug = entry.id.replace(/\.md$/, "");
          const gallery = entry.data.gallery ?? [];
          const heroImage = entry.data.heroImage;
          const allImages = heroImage ? [heroImage, ...gallery] : gallery;
          return (
        <a href={`/cases/${slug}`} class="group shrink-0 snap-start w-[300px] sm:w-[320px] bg-chassis-850 border border-chassis-800 rounded-[14px] overflow-hidden flex flex-col p-3.5 hover:border-chassis-700 hover:bg-chassis-800/60 transition-colors text-left">
          <div class="flex items-center gap-2 mb-2">
            <img src="/logo.svg" alt="" width="20" height="20" class="w-5 h-5 rounded-full bg-chassis-900 border border-chassis-800 shrink-0" loading="lazy" />
            <span class="text-[10px] font-sans font-bold uppercase tracking-wider text-chassis-500 line-clamp-1">{entry.data.category}</span>
            <span class="text-chassis-600 text-[11px]">·</span>
            <time datetime={entry.data.date.toISOString().slice(0,10)} class="text-[11px] font-sans text-chassis-400 shrink-0">{formatDateRu(entry.data.date.toISOString().slice(0,10))}</time>
          </div>
          <div class="text-[11px] font-sans text-chassis-500 mb-1 line-clamp-1">Устройство: <span class="text-chassis-300 font-bold">{entry.data.device}</span></div>
          {allImages.length === 1 && (
              <div class="rounded-lg overflow-hidden border border-chassis-800 bg-chassis-900 mb-2.5">
                <Picture src={allImages[0]} alt={entry.data.title} widths={[300, 600]} sizes="(max-width: 640px) 300px, 320px" formats={["avif", "webp"]} fallbackFormat="webp" loading="lazy" decoding="async" class="w-full h-[110px] object-cover" />
              </div>
            )}
          {allImages.length === 2 && (
            <div class="grid grid-cols-2 gap-1.5 mb-2.5">
              {allImages.map((img) => (
                  <div class="rounded-lg overflow-hidden border border-chassis-800 bg-chassis-900">
                    <Picture src={img} alt={entry.data.title} widths={[180, 360]} sizes="140px" formats={["avif", "webp"]} fallbackFormat="webp" loading="lazy" decoding="async" class="w-full h-[90px] object-cover" />
                  </div>
                ))}
            </div>
          )}
          <h3 class="text-sm font-bold text-chassis-100 leading-tight line-clamp-2 group-hover:underline underline-offset-2">{entry.data.title}</h3>
          <span class="mt-auto pt-3 ml-auto self-end text-right text-[11px] font-sans font-bold text-chassis-300 group-hover:text-chassis-100">Читать разбор →</span>
        </a>
        )})}
    </div>
    <div class="flex justify-center pt-1 gap-2 flex-wrap">
      <IconLink
        type="threads"
        href={siteConfig.socials.threads}
        label="Мы в Threads — @laptopservice_uz"
        ariaLabel="Мы в Threads — @laptopservice_uz"
        variant="button"
        target="_blank"
        class="px-6 py-3 text-sm bg-chassis-900 hover:bg-chassis-850 text-chassis-200 font-bold"
      />
      <IconLink
        type="telegram"
        href={siteConfig.telegram.masterUrl}
        label="Следите за обновлениями на нашем Telegram канале"
        ariaLabel="Следите за обновлениями на нашем Telegram канале"
        variant="button"
        target="_blank"
        class="px-6 py-3 text-sm bg-chassis-900 hover:bg-chassis-850 text-chassis-200 font-bold"
      />
    </div>
  </section>

  <!-- REVIEWS — threads-like horizontal scroller -->
  <section class="py-8 bg-chassis-950/50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-4">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-2">
        <div class="flex flex-wrap items-center gap-3">
          <h2 class="text-xl sm:text-2xl font-bold text-chassis-100">Отзывы клиентов</h2>
          <div class="flex items-center gap-3 text-xs">
            <IconLink type="yandex-maps" href={siteConfig.socials.yandexMaps} label="Яндекс Карты" ariaLabel="Открыть в Яндекс Картах" variant="inline" target="_blank" class="text-chassis-300 hover:text-chassis-100 underline" />
            <span class="text-chassis-600">•</span>
            <IconLink type="google-maps" href={siteConfig.socials.googleMaps} label="Google Maps" ariaLabel="Открыть в Google Maps" variant="inline" target="_blank" class="text-chassis-300 hover:text-chassis-100 underline" />
            <span class="text-chassis-600">•</span>
            <IconLink type="2gis" href={siteConfig.socials.twoGis} label="2ГИС" ariaLabel="Открыть в 2ГИС" variant="inline" target="_blank" class="text-chassis-300 hover:text-chassis-100 underline" />
          </div>
        </div>
        <a href="/reviews" class="text-xs font-sans text-chassis-300 hover:text-chassis-100 underline underline-offset-2 shrink-0">Оставить свой отзыв →</a>
      </div>
      {isTinaReviews && tinaReviewsPayload ? (
        <VisualReviews client:load query={tinaReviewsPayload.query} variables={tinaReviewsPayload.variables} data={tinaReviewsPayload.data} variant="home" />
      ) : (
      <div class="horizontal-scroller flex gap-2.5 overflow-x-auto overflow-y-hidden pb-2 snap-x snap-mandatory scroll-smooth -mx-4 px-4 sm:mx-0 sm:px-0 items-start">
        {reviewsEntries.slice(0, 8).map((entry) => {
          const gallery = entry.data.gallery ?? [];
          const captions = entry.data.captions ?? [];
          const avatar = entry.data.avatar;
          const fullText = entry.body?.trim() ?? "";
          const isLong = fullText.length > 200;
          const truncated = isLong ? fullText.slice(0, 200).trim() + "…" : fullText;
          return (
          <div class="shrink-0 snap-start w-[270px] sm:w-[290px] bg-chassis-850 border border-chassis-800 rounded-[14px] overflow-hidden flex flex-col p-3.5 self-start h-auto">
            <div class="flex items-center gap-2.5 mb-2">
              {avatar ? (
                <Picture src={avatar} alt={entry.data.author} widths={[28, 56]} sizes="28px" formats={["avif", "webp"]} fallbackFormat="webp" class="w-7 h-7 rounded-full object-cover border border-chassis-700 shrink-0" loading="lazy" decoding="async" />
              ) : (
                <div class="w-7 h-7 rounded-full bg-chassis-900 border border-chassis-800 flex items-center justify-center text-[11px] font-bold text-chassis-200 shrink-0">
                  {entry.data.author.charAt(0).toUpperCase()}
                </div>
              )}
              <div class="flex-1 min-w-0">
                <div class="text-xs font-bold text-chassis-100 leading-none truncate">{entry.data.author}</div>
                <div class="text-[10px] text-chassis-500 leading-none mt-0.5 truncate">{entry.data.device} · {entry.data.source}</div>
              </div>
            </div>
            <div class="flex items-center gap-1.5 mb-1.5">
              <span class="text-[11px] text-amber-400 leading-none">★★★★★</span>
              <span class="text-[11px] font-sans text-chassis-500">{entry.data.date.toISOString().slice(0,10)}</span>
            </div>
            <div class="text-xs text-chassis-300 leading-relaxed italic review-text-wrap">
              <span class="review-short">«{truncated}»</span>
              <span class="review-full hidden">«{fullText}»</span>
              {isLong && <button type="button" class="review-more ml-1 text-chassis-500 hover:text-chassis-300 underline text-xs font-sans not-italic">ещё</button>}
            </div>
            {gallery.length > 0 && (
              <div class="mt-2.5">
                <div class="rounded-lg overflow-hidden border border-chassis-800 bg-chassis-900">
                  <Picture src={gallery[0]} alt={captions[0] || ""} widths={[270, 400]} sizes="270px" formats={["avif", "webp"]} fallbackFormat="webp" loading="lazy" decoding="async" class="w-full h-[110px] object-cover" />
                </div>
                {captions[0] && <div class="text-[10px] font-sans text-chassis-500 mt-1 truncate">{captions[0]}</div>}
              </div>
            )}
          </div>
        )})}
      </div>
      )}
    </div>
  </section>

  <!-- FAQ — компактный аккордеон -->
  <section class="py-8 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-4">
    <div>
      <div class="text-xs font-sans text-chassis-400 uppercase tracking-wider">Вопросы и ответы</div>
      <h2 class="text-xl sm:text-2xl font-bold text-chassis-100">Часто задаваемые вопросы</h2>
    </div>
    <FaqAccordion faqs={homeFaq} />
  </section>

  <!-- ADDRESS & MAP STRIP -->
  <section id="location" class="py-12 scroll-mt-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        
        <div class="lg:col-span-6 space-y-4">
          <div class="text-xs font-sans text-chassis-400 uppercase tracking-wider">Локация сервисного центра</div>
          <h2 class="text-xl sm:text-2xl font-bold text-chassis-100">{siteConfig.address.fullAddress}</h2>
          <p class="text-xs sm:text-sm text-chassis-300 leading-relaxed">
            Ориентиры: напротив центрального входа Паркентского базара, магазин «Радиодетали». 
            {siteConfig.address.deliveryInfo}.
          </p>
          <div class="text-xs font-sans text-chassis-300 space-y-1 pt-1">
            <div>График: {siteConfig.workingHours.days} ({siteConfig.workingHours.hours})</div>
            <div>Телефон: <a href={`tel:${siteConfig.phones.primary}`} class="hover:text-chassis-100 underline decoration-chassis-600 underline-offset-2">{siteConfig.phones.displayPrimary}</a></div>
          </div>
          <div class="flex flex-wrap gap-2 pt-2">
            <IconLink
              type="yandex-maps"
              href={siteConfig.socials.yandexMaps}
              label="Открыть в Яндекс Картах"
              ariaLabel="Открыть в Яндекс Картах"
              variant="button"
              target="_blank"
            />
            <IconLink
              type="google-maps"
              href={siteConfig.socials.googleMaps}
              label="Открыть в Google Maps"
              ariaLabel="Открыть в Google Maps"
              variant="button"
              target="_blank"
            />
            <IconLink
              type="2gis"
              href={siteConfig.socials.twoGis}
              label="Открыть в 2ГИС"
              ariaLabel="Открыть в 2ГИС"
              variant="button"
              target="_blank"
            />
          </div>
        </div>

        <div class="lg:col-span-6 space-y-4">
          <div class="rounded-lg overflow-hidden border border-chassis-800 bg-chassis-900 h-[240px]">
            <iframe
              src="https://yandex.ru/map-widget/v1/org/81659688745/?ll=69.3148%2C41.3144&z=16&l=map"
              width="100%"
              height="100%"
              style="border:0;"
              loading="lazy"
              title="Карта — Laptop Service, Паркент 11"
              class="w-full h-full"
            ></iframe>
          </div>
          <div class="rounded border border-chassis-800 bg-chassis-900 p-6 space-y-3">
            <div class="text-xs font-sans text-chassis-400 uppercase">Прямая связь</div>
            <div class="text-sm text-chassis-200">
              По вопросам диагностики и доставки техники:
            </div>
            <div class="pt-2 flex flex-col sm:flex-row gap-2">
              <IconLink
                type="telegram"
                href={siteConfig.telegram.masterUrl}
                label={`Telegram: ${siteConfig.telegram.masterHandle}`}
                ariaLabel="Написать в Telegram"
                variant="button"
                target="_blank"
                class="border-chassis-600 bg-chassis-800 hover:bg-chassis-700 text-chassis-100 font-bold w-full sm:w-auto justify-center"
              />
              <IconLink
                type="phone"
                href={`tel:${siteConfig.phones.primary}`}
                label="Позвонить"
                ariaLabel="Позвонить"
                variant="button"
                class="bg-chassis-850 hover:bg-chassis-800 text-chassis-200 w-full sm:w-auto justify-center"
              />
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <style>
    .horizontal-scroller { scrollbar-width: none; -ms-overflow-style: none; -webkit-overflow-scrolling: touch; }
    .horizontal-scroller::-webkit-scrollbar { display: none; }
    @keyframes heroFill { from { transform: scaleX(0); } to { transform: scaleX(1); } }
  </style>

  <script is:inline>
    document.addEventListener('click', function(e) {
      var btn = e.target.closest('.review-more');
      if (!btn) return;
      var wrap = btn.closest('.review-text-wrap');
      if (!wrap) return;
      var shortEl = wrap.querySelector('.review-short');
      var fullEl = wrap.querySelector('.review-full');
      if (!shortEl || !fullEl) return;
      var isExpanded = !fullEl.classList.contains('hidden');
      if (isExpanded) {
        fullEl.classList.add('hidden');
        shortEl.classList.remove('hidden');
        btn.textContent = 'ещё';
      } else {
        shortEl.classList.add('hidden');
        fullEl.classList.remove('hidden');
        btn.textContent = 'свернуть';
      }
    });
  </script>

</BaseLayout>