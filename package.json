{
  "name": "laptopservice-uz",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "astro dev",
    "dev:tina": "tinacms dev -c \"astro dev\"",
    "start": "astro dev",
    "build": "tinacms build --local --skip-cloud-checks --skip-search-index && node -e \"try{require('fs').rmSync('public/admin',{recursive:true,force:true})}catch{}\" && node --max-old-space-size=8192 ./node_modules/astro/astro.js build && node scripts/copy-content-images.mjs",
    "build:tina": "tinacms build --local --skip-cloud-checks --skip-search-index",
    "build:check": "node --max-old-space-size=8192 ./node_modules/astro/astro.js check",
    "build:prod": "node --max-old-space-size=8192 ./node_modules/astro/astro.js build && node scripts/copy-content-images.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "threads:import": "python scripts/fetch_threads.py",
    "threads:import:dry": "python scripts/fetch_threads.py --dry-run"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/react": "^4.4.2",
    "@astrojs/sitemap": "^3.2.1",
    "@astrojs/tailwind": "^5.1.5",
    "@tailwindcss/typography": "^0.5.16",
    "astro": "^5.3.0",
    "astro-og-canvas": "^0.13.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.4",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  },
  "devDependencies": {
    "@tinacms/cli": "^2.6.1",
    "tinacms": "^3.12.1"
  }
}
